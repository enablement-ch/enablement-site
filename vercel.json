{
  "functions": {
    "api/linkedin-analysis-callback.js": { "maxDuration": 800 }
  },
  "redirects": [
    {
      "source": "/resources/competitor-content-pull",
      "destination": "/resources/linkedin-analysis",
      "permanent": true
    },
    {
      "source": "/resources/competitor-content-pull/:path*",
      "destination": "/resources/linkedin-analysis/:path*",
      "permanent": true
    },
    {
      "source": "/linkedin-results",
      "destination": "/linkedin-thoughtleadership",
      "permanent": true
    },
    {
      "source": "/resources/allbound-audit",
      "destination": "/resources/gtm-self-audit",
      "permanent": true
    },
    {
      "source": "/resources/gtm-checklist",
      "destination": "/resources/gtm-self-audit",
      "permanent": true
    },
    {
      "source": "/resources/gtm-audit",
      "destination": "/resources/gtm-self-audit",
      "permanent": true
    },
    {
      "source": "/case-studies",
      "destination": "/customer-results",
      "permanent": true
    },
    {
      "source": "/legacy-case-studies",
      "destination": "/customer-results",
      "permanent": true
    },
    {
      "source": "/case-studies/:slug(brandergroup|emporix|eyva|ohalo|scrypt|suturehealth)",
      "destination": "/legacy-case-studies/:slug",
      "permanent": true
    },
    {
      "source": "/case-studies/:path*",
      "destination": "/customer-results/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/optimizely",
      "destination": "https://roadmap.enablement.ch/optimizely"
    },
    {
      "source": "/optimizely/:path*",
      "destination": "https://roadmap.enablement.ch/optimizely/:path*"
    },
    {
      "source": "/mortgage-automator",
      "destination": "https://roadmap.enablement.ch/mortgage-automator"
    },
    {
      "source": "/mortgage-automator/:path*",
      "destination": "https://roadmap.enablement.ch/mortgage-automator/:path*"
    }
  ]
}
