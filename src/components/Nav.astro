---
const links: { href: string; label: string }[] = [
  { href: "/customer-results", label: "Customer Results" },
];

// Add future resource pages here to include them in the dropdown.
const resources: { href: string; label: string }[] = [
  { href: "/resources/gtm-audit", label: "GTM Audit" },
  { href: "/resources/ai-sales-coach", label: "AI Sales Coach" },
];

interface Props {
  /** Override the nav CTA per page (e.g. anchor to an on-page apply form). */
  ctaHref?: string;
  ctaLabel?: string;
  showLinks?: boolean;
}

const {
  ctaHref = "https://revenue.enablement.ch/meetings/l-heiz/firstmeeting",
  ctaLabel = "Schedule meeting",
  showLinks = true,
} = Astro.props;
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Enablement.ch">
      <img src="/logo-black.svg" alt="" class="logo-img logo-img-light" />
      <img src="/logo-white.svg" alt="" class="logo-img logo-img-dark" />
    </a>
    {showLinks && (
      <div class="nav-menu">
        {links.map(({ href, label }) => <a href={href}>{label}</a>)}
        <details class="nav-resources">
          <summary>Resources <span aria-hidden="true">⌄</span></summary>
          <div class="nav-resources-panel">
            {resources.map(({ href, label }) => <a href={href}>{label}</a>)}
          </div>
        </details>
      </div>
    )}
    <div class="nav-actions">
      <button
        class="theme-toggle"
        aria-label="Toggle theme"
        onclick="toggleTheme()"
      >
        <svg
          class="icon-moon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
        >
        <svg
          class="icon-sun"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          ></path></svg
        >
      </button>
      <a href={ctaHref} class="btn btn-accent btn-sm">{ctaLabel}</a>
    </div>
  </div>
</nav>

<script>
  const dropdown = document.querySelector<HTMLDetailsElement>(".nav-resources");
  if (dropdown) {
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !dropdown.contains(event.target)) {
        dropdown.open = false;
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && dropdown.open) {
        dropdown.open = false;
        dropdown.querySelector("summary")?.focus();
      }
    });
  }
</script>

<style>
  .nav-resources { position: relative; }
  .nav-resources summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    cursor: pointer;
    color: var(--color-muted);
  }
  .nav-resources summary::-webkit-details-marker { display: none; }
  .nav-resources summary:hover,
  .nav-resources[open] summary { color: var(--color-heading); }
  .nav-resources summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }
  .nav-resources summary span { transition: transform 150ms; }
  .nav-resources[open] summary span { transform: rotate(180deg); }
  .nav-resources-panel {
    position: absolute;
    top: calc(100% + var(--space-4));
    right: 0;
    min-width: 220px;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  .nav-resources-panel a {
    display: block;
    padding: var(--space-3);
    white-space: nowrap;
  }
  .nav-resources-panel a:hover,
  .nav-resources-panel a:focus-visible {
    color: var(--color-heading);
    background: var(--color-canvas);
  }
  @media (max-width: 767px) {
    .nav-inner:has(.nav-menu) {
      height: auto;
      min-height: 72px;
      flex-wrap: wrap;
      padding-top: var(--space-3);
      padding-bottom: var(--space-3);
      gap: var(--space-3);
    }
    .nav-menu {
      display: flex;
      justify-content: center;
      width: 100%;
      order: 3;
      gap: var(--space-5);
    }
  }
</style>
