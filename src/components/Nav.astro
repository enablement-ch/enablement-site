---
const links: { href: string; label: string }[] = [
  { href: "/customer-results", label: "Customer Results" },
];

// Add future resource pages here to include them in the dropdown.
const resources: { href: string; label: string }[] = [
  { href: "/resources/gtm-audit", label: "GTM Audit" },
  { href: "/resources/ai-sales-coach", label: "AI Sales Coach" },
];

const services = [
  { href: "/linkedin-thoughtleadership", label: "LinkedIn Thought Leadership" },
];

const ctaHref = "https://revenue.enablement.ch/meetings/l-heiz/firstmeeting";
const ctaLabel = "Schedule meeting";
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Enablement.ch">
      <img src="/logo-black.svg" alt="" class="logo-img logo-img-light" />
      <img src="/logo-white.svg" alt="" class="logo-img logo-img-dark" />
    </a>
      <div class="nav-menu">
        <details class="nav-services nav-dropdown">
          <summary>Services <span aria-hidden="true">⌄</span></summary>
          <div class="nav-resources-panel">
            {services.map(({ href, label }) => <a href={href}>{label}</a>)}
            <span class="nav-coming-soon">Signal-Based Outbound <small>(Coming Soon)</small></span>
            <span class="nav-coming-soon">AI Revenue Operations <small>(Coming Soon)</small></span>
          </div>
        </details>
        {links.map(({ href, label }) => <a href={href}>{label}</a>)}
        <details class="nav-resources nav-dropdown">
          <summary>Resources <span aria-hidden="true">⌄</span></summary>
          <div class="nav-resources-panel">
            {resources.map(({ href, label }) => <a href={href}>{label}</a>)}
          </div>
        </details>
      </div>
    <div class="nav-actions">
      <a href={ctaHref} class="btn btn-accent btn-sm">{ctaLabel}</a>
    </div>
  </div>
</nav>

<script>
  const dropdowns = document.querySelectorAll<HTMLDetailsElement>(".nav-dropdown");
  dropdowns.forEach((dropdown) => {
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !dropdown.contains(event.target)) {
        dropdown.open = false;
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && dropdown.open) {
        dropdown.open = false;
        dropdown.querySelector("summary")?.focus();
      }
    });
  });
</script>

<style>
  .nav-dropdown { position: relative; }
  .nav-dropdown summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    cursor: pointer;
    color: var(--color-muted);
  }
  .nav-dropdown summary::-webkit-details-marker { display: none; }
  .nav-dropdown summary:hover,
  .nav-dropdown[open] summary { color: var(--color-heading); }
  .nav-dropdown summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }
  .nav-dropdown summary span { transition: transform 150ms; }
  .nav-dropdown[open] summary span { transform: rotate(180deg); }
  .nav-resources-panel {
    position: absolute;
    top: calc(100% + var(--space-4));
    right: 0;
    min-width: 220px;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }
  .nav-services .nav-resources-panel { left: 0; right: auto; }
  .nav-resources-panel a {
    display: block;
    padding: var(--space-3);
    white-space: nowrap;
  }
  .nav-resources-panel a:hover,
  .nav-resources-panel a:focus-visible {
    color: var(--color-heading);
    background: var(--color-canvas);
  }
  .nav-coming-soon {
    display: block;
    padding: var(--space-3);
    white-space: nowrap;
    color: var(--color-muted);
  }
  .nav-coming-soon small { font-size: 0.75em; }
  @media (max-width: 767px) {
    .nav-inner:has(.nav-menu) {
      height: auto;
      min-height: 72px;
      flex-wrap: wrap;
      padding-top: var(--space-3);
      padding-bottom: var(--space-3);
      gap: var(--space-3);
    }
    .nav-menu {
      display: flex;
      justify-content: center;
      width: 100%;
      order: 3;
      gap: var(--space-5);
      position: relative;
    }
    .nav-dropdown { position: static; }
  }
  @media (max-width: 480px) {
    .nav-menu {
      gap: var(--space-3);
      font-size: 0.65rem;
      letter-spacing: 0.06em;
    }
  }
</style>
