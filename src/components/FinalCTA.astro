---
import LeadIntakeForm from "./LeadIntakeForm.astro";

interface Props {
  headline?: string;
  accent?: string;
  lead?: string;
  submitLabel?: string;
}

const {
  headline = "Ready to turn your tools into",
  accent = "a GTM system?",
  lead = "Book a 30-min GTM session. We'll audit your pipeline, find the highest-leverage action to take, and tell you whether we're a fit. If we're not, we'll point you to who is.",
  submitLabel = "Book a GTM session",
} = Astro.props;
---

<section class="section cta-section">
  <div class="container">
    <div class="cta-inner">
      <h2>
        {headline} <span class="italic-accent">{accent}</span>
      </h2>
      <p class="lead">
        {lead}
      </p>
      <LeadIntakeForm theme="dark" submitLabel={submitLabel} />
    </div>
  </div>
</section>
