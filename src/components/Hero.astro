---
import LeadIntakeForm from "./LeadIntakeForm.astro";

interface Props {
  eyebrow?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  /** Rotating headlines. The first entry is the static and reduced-motion fallback. */
  rotatingHeadlines?: { lead: string; accent: string }[];
  /** Vimeo URL (any format) for the hero VSL. Loaded on click. */
  vimeoUrl?: string;
}

const {
  eyebrow = "GTM Engineering for B2B tech companies with proven product-market fit",
  primaryHref = "https://revenue.enablement.ch/meetings/l-heiz/firstmeeting",
  primaryLabel = "Schedule meeting",
  secondaryHref = "/customer-results",
  secondaryLabel = "See client work",
  rotatingHeadlines = [
    { lead: "Build and design your", accent: "Allbound engine." },
    { lead: "Be the company buyers", accent: "already trust." },
    { lead: "Reach the right people", accent: "at the right time." },
    { lead: "Grow revenue", accent: "without adding headcount." },
  ],
  vimeoUrl = "https://vimeo.com/1054121771/bbe92f66a3",
} = Astro.props;

// Parse Vimeo URL: vimeo.com/{id}/{hash} or vimeo.com/{id}
const vimeoMatch = vimeoUrl?.match(/vimeo\.com\/(\d+)(?:\/([a-zA-Z0-9]+))?/);
const vimeoId = vimeoMatch?.[1];
const vimeoHash = vimeoMatch?.[2];

// Fetch the Vimeo thumbnail at build time so the facade renders a preview image
// instead of an empty card.
let vimeoThumb = "";
if (vimeoUrl) {
  try {
    const res = await fetch(
      `https://vimeo.com/api/oembed.json?url=${encodeURIComponent(vimeoUrl)}`
    );
    if (res.ok) {
      const data = await res.json();
      vimeoThumb = (data.thumbnail_url || "").replace(/_\d+x\d+/, "_1280");
    }
  } catch (e) {
    // graceful fallback - facade renders without thumbnail
  }
}
---

<header class="hero texture-grid">
  <div class="container">
    <div class="hero-inner">
      <span class="eyebrow"
        >{eyebrow}</span
      >
      <h1 class="display home-display">
        <span class="rotating-word" data-headlines={JSON.stringify(rotatingHeadlines)}><span class="headline-lead">{rotatingHeadlines[0].lead} </span><span class="headline-accent">{rotatingHeadlines[0].accent}</span></span>
      </h1>
      <p class="lead hero-lead">
        Your fractional GTM engineering team. We turn your tools into outbound,
        inbound, and RevOps systems that work as one.
      </p>
    </div>
  </div>

  <!-- VSL frame under the headline -->
  <div class="hero-visual">
    <div
      class:list={["hero-visual-frame", "vimeo-facade", vimeoThumb && "has-thumb"]}
      aria-label="Intro video"
      data-vimeo-id={vimeoId}
      data-vimeo-hash={vimeoHash}
      style={vimeoThumb
        ? `background-image: url(${vimeoThumb}); background-size: cover; background-position: center;`
        : undefined}
    >
      <div class="hero-visual-play">
        <button class="play-btn" aria-label="Play intro video">
          <svg viewBox="0 0 24 24" fill="currentColor"
            ><path d="M8 5v14l11-7z"></path></svg
          >
        </button>
      </div>
    </div>
  </div>

  <!-- CTAs below the video -->
  <div class="container">
    <div class="hero-actions hero-actions-below">
      <LeadIntakeForm submitLabel={primaryLabel} />
      {secondaryLabel && (
        <a href={secondaryHref} class="btn btn-tertiary"
          >{secondaryLabel} <span class="arrow">→</span></a
        >
      )}
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    if (
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;
    document.querySelectorAll(".rotating-word").forEach((el) => {
      let headlines = [];
      try {
        headlines = JSON.parse(el.dataset.headlines || "[]");
      } catch (e) {
        return;
      }
      if (!headlines || headlines.length <= 1) return;
      const lead = el.querySelector(".headline-lead");
      const accent = el.querySelector(".headline-accent");
      if (!lead || !accent) return;
      let i = 0;
      setInterval(() => {
        el.classList.add("fading");
        setTimeout(() => {
          i = (i + 1) % headlines.length;
          lead.textContent = headlines[i].lead + " ";
          accent.textContent = headlines[i].accent;
          el.classList.remove("fading");
        }, 300);
      }, 3500);
    });
  })();
</script>

<style>
  .home-display {
    max-width: 19ch;
    min-height: 2.1em;
    text-wrap: balance;
  }
  .home-display .rotating-word {
    display: block;
  }
  .headline-lead {
    color: var(--color-heading);
    font-style: normal;
    font-weight: 600;
  }
  .headline-accent {
    color: var(--color-accent);
    font-style: italic;
    font-weight: 400;
  }
  @media (max-width: 640px) {
    .home-display { min-height: 3.15em; }
  }
</style>
