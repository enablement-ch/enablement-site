---
import BaseLayout from "../layouts/BaseLayout.astro";
import VideoTestimonials from "../components/VideoTestimonials.astro";
import ThoughtLeadershipFlow from "../components/visuals/ThoughtLeadershipFlow.astro";

const impressions = [
  "/linkedin-results/img/impressions/impressions-2.5m.png",
  "/linkedin-results/img/impressions/impressions-2.49m.png",
  "/linkedin-results/img/impressions/engagement-37k.png",
  "/linkedin-results/img/impressions/followers-20k.png",
  "/linkedin-results/img/impressions/small-account-spike.png",
  "/linkedin-results/img/impressions/top-posts.png",
];

const dms = [
  "/linkedin-results/img/dms/dm-carolyn-b.png",
  "/linkedin-results/img/dms/dm-jennifer-b.png",
  "/linkedin-results/img/dms/dm-arman-b.png",
  "/linkedin-results/img/dms/dm-jake-b.png",
  "/linkedin-results/img/dms/dm-enrico-b.png",
];

const meetingUrl = "https://revenue.enablement.ch/meetings/l-heiz/firstmeeting";
const ctaLabel = "I want to fix my LinkedIn system";

const problems = [
  {
    number: "01",
    title: "Your competitors sound just like you on paper.",
    body: "When buyers cannot tell providers apart, they choose the name they already know and trust. If your expertise is invisible, every sales conversation starts with proving you are credible.",
    result: "Build recognition before the first conversation.",
  },
  {
    number: "02",
    title: "The founder has the ideas. Nobody has the time to publish them well.",
    body: "Good content needs the right argument, hook, design, and consistency. The founder should supply the insight, not become a full-time writer, designer, and distribution team.",
    result: "Make the founder's expertise visible at a sustainable cadence.",
  },
  {
    number: "03",
    title: "The posts get attention. Sales still starts from cold.",
    body: "Impressions and likes show that people saw the content. They do not identify which companies fit, who is ready for a conversation, or whether anyone followed up.",
    result: "Turn relevant engagement into qualified conversations.",
  },
];

const stages = [
  {
    number: "01",
    title: "Strategy and research",
    body: "We interview the founder, study the market and competitors, define the buyer beliefs to shift, and turn real expertise into a point of view. AI agents accelerate research; people decide what is worth saying.",
    detail: "One-hour kickoff and strategy session",
  },
  {
    number: "02",
    title: "Content and design",
    body: "We turn biweekly interviews into LinkedIn posts, graphics, and lead magnets where they fit the strategy. Human editors shape the argument and preserve the founder's voice. You review before anything goes live.",
    detail: "30-45 minute interviews every two weeks",
  },
  {
    number: "03",
    title: "Conversion and CRM",
    body: "We identify relevant visitors, commenters, reactors, and lead magnet requests; check fit at account and contact level; start contextual conversations; and connect the activity to your CRM.",
    detail: "Monthly reporting on content and commercial signals",
  },
];

const questions = [
  {
    q: "How much time does the founder need to spend?",
    a: "Plan for a one-hour kickoff, then a 30-45 minute interview every two weeks. We handle research, writing, design, signal capture, and execution. You provide your perspective, materials, access, and approvals.",
  },
  {
    q: "Will the content sound like me or like AI?",
    a: "It starts with your actual stories, opinions, customer conversations, and market experience. AI helps with research and workflow tasks. People interview, write, edit, and check every piece against your voice before you approve it.",
  },
  {
    q: "Do you contact everyone who engages with a post?",
    a: "No. We first check whether the person and company fit your ideal customer profile and whether there is a relevant reason to reach out. The goal is a useful conversation, not a blast to every liker.",
  },
  {
    q: "What does the 30-day money-back guarantee cover?",
    a: "If you attend the agreed interviews and provide the materials and access we need, but are unhappy with the engagement at the end of your first 30 days, we'll refund your first month's fee. No questions asked.",
  },
];
---

<BaseLayout
  title="LinkedIn Thought Leadership for B2B Founders | Enablement.ch"
  description="Founder-led LinkedIn content that builds trust, captures buying signals, and starts qualified sales conversations. See real results from Enablement.ch."
>
  <main class="linkedin-service">
    <header class="service-hero texture-grid">
      <div class="container service-hero-grid">
        <div class="service-hero-copy">
          <span class="eyebrow">LinkedIn thought leadership for B2B tech founders</span>
          <h1>Be the company buyers <span class="italic-accent">already trust.</span></h1>
          <p class="lead">We turn your expertise into content that makes you known in your market. Then we identify the right people engaging with it and start relevant sales conversations. Strategy, content, and conversion in one system.</p>
          <div class="service-actions">
            <a href={meetingUrl} class="btn btn-accent btn-md">{ctaLabel}</a>
            <a href="#real-examples" class="text-link">See real examples <span aria-hidden="true">→</span></a>
          </div>
          <p class="service-hero-fit">Best for founders and executives who have tried LinkedIn, operate in a crowded market, and want content to contribute to pipeline.</p>
        </div>
        <ThoughtLeadershipFlow />
      </div>
    </header>

    <section class="section service-problems" id="problems">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">The real problem</span>
          <h2>Being good at what you do does not mean buyers <span class="italic-accent">know why to choose you.</span></h2>
          <p class="lead">In a crowded category, trust is built before the first sales call. These three gaps keep that trust from turning into revenue.</p>
        </div>
        <div class="problem-grid">
          {problems.map((problem) => (
            <article class="problem-card">
              <span class="problem-number">{problem.number}</span>
              <h3>{problem.title}</h3>
              <p>{problem.body}</p>
              <div class="problem-result"><span class="result-dot" aria-hidden="true"></span>{problem.result}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section service-system texture-glow" id="how-it-works">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">How we build it</span>
          <h2>One system from your point of view to <span class="italic-accent">pipeline.</span></h2>
          <p class="lead">Human insight sets the direction. AI agents speed up research and workflows. We build and run the content and the conversion system around both.</p>
        </div>
        <div class="stage-grid">
          {stages.map((stage) => (
            <article class="stage-card">
              <span class="stage-number">{stage.number}</span>
              <h3>{stage.title}</h3>
              <p>{stage.body}</p>
              <div class="stage-detail">{stage.detail}</div>
            </article>
          ))}
        </div>
        <div class="system-bridge"><span class="bridge-dot" aria-hidden="true"></span>Every piece of content has a job. Every relevant signal has a next step.</div>
      </div>
    </section>

  <!-- Keep the complete original screenshot galleries and click-to-enlarge behavior. -->
  <section class="section scrolly" id="real-examples">
    <div class="container">
      <span class="eyebrow">Real examples · Attention</span>
      <div class="scrolly-concept-mobile">
        <h3>Ideas that make your market <span class="italic-accent">pay attention.</span></h3>
        <p class="lead">These are real examples of reach and engagement from content systems we have built. Reach matters because buyers cannot trust a name they have never encountered.</p>
      </div>
      <div class="scrolly-grid">
        <aside class="scrolly-aside">
          <div class="scrolly-sticky">
            <h3>Ideas that make your market <span class="italic-accent">pay attention.</span></h3>
            <p class="lead">These are real examples of reach and engagement from content systems we have built. Reach matters because buyers cannot trust a name they have never encountered.</p>
            <p class="proof-caption">Click any screenshot to view it at full size.</p>
          </div>
        </aside>
        <div class="scrolly-steps">
          {impressions.map((src) => (
            <div class="scrolly-step">
              <figure class="scrolly-card" role="button" tabindex="0" aria-label="Enlarge LinkedIn reach example"><img loading="lazy" src={src} alt="LinkedIn reach or engagement result from a content system" /></figure>
            </div>
          ))}
        </div>
      </div>
      <div class="section-cta"><a href={meetingUrl} class="btn btn-accent btn-md">{ctaLabel}</a></div>
    </div>
  </section>

  <section class="section scrolly conversation-gallery" id="conversations">
    <div class="container">
      <span class="eyebrow">Real examples · Conversations</span>
      <div class="scrolly-concept-mobile">
        <h3>From a familiar name to a <span class="italic-accent">real reply.</span></h3>
        <p class="lead">Some buyers start the conversation themselves. For the ones who engage but stay quiet, we check fit and give sales a relevant reason to reach out.</p>
      </div>
      <div class="scrolly-grid">
        <aside class="scrolly-aside">
          <div class="scrolly-sticky">
            <h3>From a familiar name to a <span class="italic-accent">real reply.</span></h3>
            <p class="lead">Some buyers start the conversation themselves. For the ones who engage but stay quiet, we check fit and give sales a relevant reason to reach out.</p>
            <p class="proof-caption">Click any screenshot to view it at full size.</p>
          </div>
        </aside>
        <div class="scrolly-steps">
          {dms.map((src) => (
            <div class="scrolly-step">
              <figure class="scrolly-card" role="button" tabindex="0" aria-label="Enlarge LinkedIn conversation example"><img loading="lazy" src={src} alt="LinkedIn message showing a sales conversation" /></figure>
            </div>
          ))}
        </div>
      </div>
      <div class="section-cta"><a href={meetingUrl} class="btn btn-accent btn-md">{ctaLabel}</a></div>
    </div>
  </section>

    <section class="section customer-proof" id="customer-proof">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Customer proof</span>
          <h2>Recognition opens the door. A connected system <span class="italic-accent">moves the deal.</span></h2>
          <p class="lead">Two different outcomes show the value of each half: content that earns trust, and a sales motion that acts on it.</p>
        </div>
        <div class="customer-proof-grid">
          <article class="customer-proof-card">
            <span class="proof-type">Content to inbound</span>
            <img src="/logos/ekipa-black.png" alt="Ekipa" class="proof-logo" loading="lazy" />
            <h3>A LinkedIn post helped Ekipa win Caritas.</h3>
            <p>Ekipa's co-CEO said Caritas hired them for a pilot after seeing content we helped create. That is a buyer arriving with context before the first sales call.</p>
            <a href="/customer-results/ekipa" class="text-link">Read the Ekipa story <span aria-hidden="true">→</span></a>
          </article>
          <article class="customer-proof-card">
            <span class="proof-type">Brand plus outbound</span>
            <img src="/logos/blueprint-black.png" alt="Blueprint" class="proof-logo" loading="lazy" />
            <h3>Blueprint's brand gave outreach a warmer start.</h3>
            <p>Our broader global outbound system combined research, email, and LinkedIn to produce 30-40 qualified meetings a month and more than $10M in closed revenue. This is proof of the connected GTM motion, not a content-only result.</p>
            <a href="/customer-results/blueprint" class="text-link">Read the Blueprint story <span aria-hidden="true">→</span></a>
          </article>
        </div>
        <div class="section-cta"><a href={meetingUrl} class="btn btn-accent btn-md">{ctaLabel}</a></div>
      </div>
    </section>

    <VideoTestimonials
      eyebrow="Customer voices · The wider GTM system"
      headline="Hear what changed beyond the post."
      lead="These clients describe results from connected GTM work across content, outreach, and revenue operations. Their outcomes are not attributed to LinkedIn content alone."
    />

    <section class="section service-offer texture-hybrid" id="the-offer">
      <div class="container offer-grid">
        <div class="offer-copy">
          <span class="eyebrow">The engagement</span>
          <h2>Bring your perspective. <span class="italic-accent">We build the system.</span></h2>
          <p class="lead">The standard engagement includes strategy, content production, signal identification, relevant outreach, and CRM integration. It is built for founders who want LinkedIn to support sales without running a content operation themselves.</p>
          <a href={meetingUrl} class="btn btn-accent btn-md">{ctaLabel}</a>
        </div>
        <div class="offer-details">
          <div class="offer-detail"><span class="offer-detail-dot" aria-hidden="true"></span><div><strong>Your part</strong><p>One-hour kickoff, biweekly 30-45 minute interviews, materials, access, and approvals.</p></div></div>
          <div class="offer-detail"><span class="offer-detail-dot" aria-hidden="true"></span><div><strong>Our part</strong><p>Research, writing, design, lead magnets where useful, signal capture, fit checks, outreach, CRM integration, and monthly reporting.</p></div></div>
          <div class="offer-detail"><span class="offer-detail-dot" aria-hidden="true"></span><div><strong>30-day money-back guarantee</strong><p>If you're unhappy with our engagement at the end of your first 30 days, we'll refund your first month's fee.</p></div></div>
        </div>
      </div>
    </section>

    <section class="section service-faq" id="questions">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Before we start</span>
          <h2>Common questions.</h2>
        </div>
        <div class="service-faq-list">
          {questions.map((item) => (
            <details class="service-faq-item">
              <summary>{item.q}<span aria-hidden="true">+</span></summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section service-final-cta">
      <div class="container">
        <div class="final-cta-card">
          <span class="eyebrow">From content to conversations</span>
          <h2>Make your expertise impossible to miss, then give sales a way to act on it.</h2>
          <p>Book a 30-minute GTM session. We will look at what you publish today, who it reaches, and where interested buyers fall out of the process.</p>
          <a href={meetingUrl} class="btn btn-accent btn-md">{ctaLabel}</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .linkedin-service {
    --service-pink: #FFF2F5;
    --service-pink-strong: #FCE8ED;
    --service-red-soft: #FBE6E9;
    --service-green-soft: #E5F4E9;
  }
  :global([data-theme="dark"] .linkedin-service) {
    --service-pink: #241A20;
    --service-pink-strong: #35202A;
    --service-red-soft: #3B2028;
    --service-green-soft: #193526;
  }
  :global(.linkedin-service section.section) { padding-block: 72px; }
  :global(.linkedin-service .eyebrow) { color: var(--color-accent); }
  .service-hero {
    --texture-base: var(--color-canvas);
    padding: 72px 0 64px;
    border-bottom: 1px solid var(--color-border);
  }
  .service-hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: var(--space-7); align-items: center; }
  .service-hero h1 { max-width: 730px; margin-top: var(--space-4); font-size: clamp(2.7rem, 5vw, 4.6rem); font-weight: 700; }
  .service-hero .lead { max-width: 650px; margin-top: var(--space-5); }
  .service-actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-5); margin-top: var(--space-6); }
  .text-link { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-accent); font-weight: 700; text-decoration: none; }
  .text-link:hover { color: var(--color-accent-hover); text-decoration: underline; text-underline-offset: 4px; }
  .service-hero-fit { max-width: 610px; margin-top: var(--space-5); color: var(--color-muted); font-size: .9rem; }

  .section-heading { max-width: 850px; margin-bottom: var(--space-6); }
  .section-heading h2 { margin-top: var(--space-3); font-size: clamp(2.1rem, 4vw, 3.1rem); }
  .section-heading .lead { margin-top: var(--space-3); }
  .service-problems { background: var(--color-surface); }
  .problem-grid, .stage-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .problem-card { display: flex; flex-direction: column; min-width: 0; padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface-raised); }
  .problem-number, .stage-number { color: var(--color-accent); font: 700 .8rem var(--font-mono); }
  .problem-card h3, .stage-card h3 { margin-top: var(--space-4); font-size: clamp(1.3rem, 2vw, 1.65rem); font-weight: 700; }
  .problem-card p, .stage-card p { margin-top: var(--space-3); color: var(--color-body); font-size: .95rem; line-height: 1.55; }
  .problem-result { display: flex; align-items: flex-start; gap: var(--space-2); margin-top: auto; padding-top: var(--space-5); color: var(--color-heading); font-weight: 700; font-size: .9rem; }
  .result-dot { flex: 0 0 8px; width: 8px; height: 8px; margin-top: 7px; border-radius: 50%; background: var(--color-accent); }

  .service-system { --texture-base: var(--service-pink); }
  .stage-card { display: flex; flex-direction: column; min-width: 0; padding: var(--space-5); border: 1px solid var(--color-border); border-top: 3px solid var(--color-accent); border-radius: var(--radius-md); background: var(--color-surface); }
  .stage-detail { margin-top: auto; padding-top: var(--space-5); color: var(--color-accent); font: 700 .74rem var(--font-mono); line-height: 1.5; }
  .system-bridge { display: flex; align-items: center; gap: var(--space-3); margin-top: var(--space-5); padding: var(--space-4) var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-heading); font-weight: 700; }
  .bridge-dot { flex: 0 0 10px; width: 10px; height: 10px; border-radius: 50%; background: var(--color-accent); }

  .conversation-gallery { background: var(--service-pink); }
  .proof-caption { margin-top: var(--space-5); color: var(--color-muted); font-family: var(--font-mono); font-size: .75rem; }

  .customer-proof { background: var(--color-surface); }
  .customer-proof-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .customer-proof-card { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; padding: var(--space-6); border: 1px solid var(--color-border); border-left: 3px solid var(--color-accent); border-radius: var(--radius-md); background: var(--color-surface-raised); }
  .proof-type { color: var(--color-accent); font: 700 .72rem var(--font-mono); letter-spacing: .06em; text-transform: uppercase; }
  .proof-logo { max-width: 145px; width: auto; height: 42px; margin-top: var(--space-5); object-fit: contain; object-position: left center; }
  :global([data-theme="dark"] .proof-logo) { filter: invert(1); }
  .customer-proof-card h3 { margin-top: var(--space-5); font-size: clamp(1.4rem, 2.3vw, 2rem); }
  .customer-proof-card p { margin-top: var(--space-3); color: var(--color-body); font-size: .95rem; }
  .customer-proof-card .text-link { margin-top: auto; padding-top: var(--space-5); }
  .section-cta { display: flex; justify-content: center; margin-top: var(--space-6); }

  .service-offer { --texture-base: var(--service-pink); }
  .offer-grid { display: grid; grid-template-columns: .95fr 1.05fr; gap: var(--space-8); align-items: start; }
  .offer-copy h2 { margin-top: var(--space-3); font-size: clamp(2.1rem, 4vw, 3.1rem); }
  .offer-copy .lead { margin-top: var(--space-4); }
  .offer-copy .btn { margin-top: var(--space-6); }
  .offer-details { border-top: 1px solid var(--color-border-strong); }
  .offer-detail { display: flex; gap: var(--space-4); padding: var(--space-5) 0; border-bottom: 1px solid var(--color-border); }
  .offer-detail-dot { flex: 0 0 24px; width: 24px; height: 24px; border-radius: 50%; background: var(--service-red-soft); position: relative; }
  .offer-detail-dot::after { content: ""; position: absolute; inset: 8px; border-radius: 50%; background: var(--color-accent); }
  .offer-detail strong { display: block; color: var(--color-heading); font-size: 1.1rem; }
  .offer-detail p { margin-top: var(--space-2); color: var(--color-body); font-size: .95rem; }

  .service-faq { background: var(--color-surface); }
  .service-faq-list { border-top: 1px solid var(--color-border-strong); }
  .service-faq-item { border-bottom: 1px solid var(--color-border); }
  .service-faq-item summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-5); padding: var(--space-5) 0; color: var(--color-heading); font-size: 1.12rem; font-weight: 700; cursor: pointer; list-style: none; }
  .service-faq-item summary::-webkit-details-marker { display: none; }
  .service-faq-item summary span { color: var(--color-accent); font: 500 1.5rem var(--font-sans); }
  .service-faq-item[open] summary span { transform: rotate(45deg); }
  .service-faq-item p { max-width: 760px; padding: 0 0 var(--space-5); color: var(--color-body); }
  .service-faq-item summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

  .service-final-cta { background: var(--color-canvas); }
  .final-cta-card { padding: clamp(32px, 6vw, 72px); border-radius: var(--radius-lg); background: #0F1217; text-align: center; }
  .final-cta-card .eyebrow { color: #F77E99; }
  .final-cta-card h2 { max-width: 900px; margin: var(--space-3) auto 0; color: #fff; font-size: clamp(2rem, 4vw, 3.1rem); }
  .final-cta-card p { max-width: 610px; margin: var(--space-4) auto 0; color: #C6CDD7; }
  .final-cta-card .btn { margin-top: var(--space-6); }

  /* ---- image lightbox ---- */
  .img-lightbox {
    position: fixed; inset: 0; z-index: 60; display: none;
    align-items: center; justify-content: center; padding: var(--space-6);
    background: rgba(15, 18, 23, 0.92); cursor: zoom-out;
  }
  .img-lightbox.open { display: flex; }
  .img-lightbox img { max-width: 92vw; max-height: 90vh; border-radius: var(--radius-md); box-shadow: var(--shadow-lg); }

  /* ---- screenshot galleries ---- */
  section.scrolly { padding-block: 72px; }
  .scrolly .eyebrow { margin-bottom: var(--space-5); display: inline-flex; }

  .scrolly-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
  .scrolly-aside { display: none; }
  .scrolly-concept-mobile { margin-bottom: var(--space-6); }
  .scrolly-concept-mobile h3 { font-size: var(--font-size-h4); }
  .scrolly-concept-mobile p { margin-top: var(--space-3); }

  @media (min-width: 1024px) {
    .scrolly-grid { grid-template-columns: 0.82fr 1.18fr; gap: var(--space-7); }
    .scrolly-aside { display: block; }
    .scrolly-concept-mobile { display: none; }
  }

  .scrolly-sticky {
    position: sticky; top: 12vh;
    display: flex; flex-direction: column;
  }
  .scrolly-sticky h3 { font-size: var(--font-size-h2); letter-spacing: -0.025em; }
  .scrolly-sticky p { margin-top: var(--space-4); max-width: 32ch; }
  .scrolly-step { padding: var(--space-3) 0; }
  @media (min-width: 1024px) {
    .scrolly-steps {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }
    .scrolly-step { min-height: 0; padding: 0; }
  }

  .scrolly-card {
    margin: 0; width: 100%; overflow: hidden; cursor: zoom-in;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    transition: opacity var(--motion-duration-base) var(--motion-ease-standard),
                transform var(--motion-duration-base) var(--motion-ease-standard),
                box-shadow var(--motion-duration-base) var(--motion-ease-standard);
  }
  .scrolly-card img { display: block; width: 100%; height: auto; }
  .scrolly-card:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; }

  @media (min-width: 1024px) {
