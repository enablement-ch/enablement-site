---
import BaseLayout from "../layouts/BaseLayout.astro";
import MarqueeLogoWall from "../components/MarqueeLogoWall.astro";

const meetingUrl = "https://revenue.enablement.ch/meetings/l-heiz/firstmeeting";

const problems = [
  {
    number: "01",
    title: "You are burning through a market you cannot replace.",
    body: "More sends are not helping when the same finite group of buyers sees another vague pitch. Low reply rates are a sign that targeting, timing, and the reason to talk need work.",
  },
  {
    number: "02",
    title: "You bought the tools. Your team still does the work by hand.",
    body: "Clay finds emails, reps move CSVs, and CRM records need manual repairs. The stack exists, but the research, qualification, and handoffs have never become one workflow.",
  },
  {
    number: "03",
    title: "Your message knows their name, but not their problem.",
    body: "A job change or funding round is only an observation. Buyers respond when the message connects a credible problem, a reason it matters now, and a useful next step.",
  },
  {
    number: "04",
    title: "Interest appears, then disappears between inbox and sales.",
    body: "Poor sending health keeps messages out of sight. When replies do arrive, weak classification and CRM routing leave sales without the context or ownership to follow through.",
  },
];

const steps = [
  {
    number: "01",
    title: "Focus the market",
    body: "Define the accounts, buyers, problems, and offers worth pursuing. Build one shared view of fit before anyone starts sending.",
    output: "A market map and clear buyer criteria",
  },
  {
    number: "02",
    title: "Find and qualify signals",
    body: "Connect useful signals from your website, content, CRM, hiring, events, and market data. Enrich and score accounts so a signal becomes a reason to act.",
    output: "Prioritized accounts with context",
  },
  {
    number: "03",
    title: "Launch relevant outreach",
    body: "Build messages around the buyer's likely problem and match the channel to the opportunity. Set up and monitor the sending infrastructure that gets those messages seen.",
    output: "Email, LinkedIn, and call plays where they fit",
  },
  {
    number: "04",
    title: "Route, measure, improve",
    body: "Classify replies, send qualified interest to the right person, and give sales the full account context in the CRM. Use outcomes to improve the next play.",
    output: "A visible path from signal to pipeline",
  },
];

const plays = [
  {
    number: "01 / COVERAGE",
    title: "Market coverage",
    body: "Reach a defined segment with a tested problem and offer. Every account must fit, and the message must earn the interruption.",
    example: "Example: finance leaders at growth-stage companies with complex cross-border payments.",
  },
  {
    number: "02 / TIMING",
    title: "Signal-triggered outreach",
    body: "Act when a relevant company or person does something that changes the conversation. Check fit and context before outreach starts.",
    example: "Example: a target account revisits your site after engaging with a founder's LinkedIn post.",
  },
  {
    number: "03 / DEPTH",
    title: "Named-account ABM",
    body: "Go deeper on a small set of valuable accounts. Map decision-makers, develop a specific angle, and coordinate touches across channels.",
    example: "Example: a shortlist of enterprise accounts before a category conference.",
  },
];

const questions = [
  {
    q: "Do we need a large outbound team or a new stack?",
    a: "No. We start with your market, current tools, CRM, and available capacity. The system can support an existing team or give a lean team an outbound motion without adding manual research and admin work.",
  },
  {
    q: "Is this just cold email?",
    a: "No. Email may be one channel, alongside LinkedIn and calls where they make sense. The core is deciding whom to contact, why now, what to say, and how a qualified response reaches sales.",
  },
  {
    q: "What counts as a signal?",
    a: "A signal is a useful change or action, such as relevant website activity, content engagement, a hiring pattern, an event, or a change in a target account. It only triggers outreach after we check account fit and whether the signal relates to a problem you solve.",
  },
  {
    q: "Can your team run the system after building it?",
    a: "Yes. We can build the engine and enable your team to operate it, or build it and continue running the campaigns, monitoring, routing, and optimization with you. We recommend the model that fits your team's capacity.",
  },
  {
    q: "How does this work with LinkedIn thought leadership?",
    a: "Content can create awareness and first-party engagement signals. We qualify the people and accounts behind those signals, then start relevant conversations when there is a reason to do so. The outbound system can also use other market and account signals when you do not run a content program.",
  },
];
---

<BaseLayout
  title="Signal-Based Outbound for B2B Tech | Enablement.ch"
  description="Build a signal-based outbound system that reaches the right B2B buyers, starts relevant conversations, and connects qualified interest to your CRM."
>
  <main class="outbound-service">
    <header class="hero texture-grid">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Signal-Based Outbound</span>
          <h1>Reach the right buyers when there is <span class="italic-accent">a reason to talk.</span></h1>
          <p class="lead">We build outbound around market fit, buying signals, relevant messages, and clean sales handoffs. Your team gets qualified conversations without relying on more manual research or indiscriminate volume.</p>
          <div class="hero-actions">
            <a href={meetingUrl} class="btn btn-accent btn-md">Build my outbound system</a>
            <a href="#customer-proof" class="text-link">See customer results <span aria-hidden="true">→</span></a>
          </div>
          <p class="fit-note">For B2B tech teams starting outbound or rebuilding a motion that is not producing reliable pipeline.</p>
        </div>
        <div class="hero-visual" role="img" aria-label="Qualified buyer signals flow through research and relevant outreach into sales conversations">
          <div class="visual-top"><span class="visual-kicker">One connected motion</span><span class="visual-live"><span aria-hidden="true"></span> SIGNAL ACTIVE</span></div>
          <div class="visual-account"><span class="account-avatar" aria-hidden="true">A</span><div><strong>Target account</strong><small>Fits your market and buyer criteria</small></div><span class="visual-check" aria-hidden="true">✓</span></div>
          <div class="visual-line" aria-hidden="true"></div>
          <div class="visual-signal"><span class="signal-icon" aria-hidden="true">↗</span><div><strong>A relevant moment appears</strong><small>Signal + context + likely problem</small></div></div>
          <div class="visual-line" aria-hidden="true"></div>
          <div class="visual-conversation"><span class="conversation-icon" aria-hidden="true">↳</span><div><strong>A conversation starts</strong><small>Relevant outreach and a useful next step</small></div></div>
          <div class="visual-footer"><span>QUALIFY</span><span aria-hidden="true">→</span><span>ENGAGE</span><span aria-hidden="true">→</span><span>ROUTE TO SALES</span></div>
        </div>
      </div>
    </header>

    <MarqueeLogoWall />

    <section class="section problems-section" id="problems">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">The outbound problem</span>
          <h2>More activity will not fix a <span class="italic-accent">broken motion.</span></h2>
          <p class="lead">These are the problems we see when companies have people and tools in place, but outbound still does not turn into dependable pipeline.</p>
        </div>
        <div class="problem-grid">
          {problems.map((problem) => (
            <article class="problem-card">
              <span class="card-number">{problem.number}</span>
              <h3>{problem.title}</h3>
              <p>{problem.body}</p>
            </article>
          ))}
        </div>
        <a href="/resources/gtm-audit" class="text-link diagnostic-link">See the wider GTM system audit <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="section process-section texture-glow" id="how-it-works">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">How we build it</span>
          <h2>Four steps from market focus to <span class="italic-accent">sales conversation.</span></h2>
          <p class="lead">The tools only help when each step passes useful context to the next. We build the full loop, then improve it with what buyers actually do and say.</p>
        </div>
        <div class="steps-grid">
          {steps.map((step) => (
            <article class="step-card">
              <span class="step-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              <div class="step-output"><span aria-hidden="true">↳</span>{step.output}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section plays-section" id="campaign-plays">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Different markets need different plays</span>
          <h2>One system. <span class="italic-accent">Three ways to use it.</span></h2>
          <p class="lead">We choose the play based on market size, buyer readiness, deal value, and the evidence we can actually find.</p>
        </div>
        <div class="plays-grid">
          {plays.map((play) => (
            <article class="play-card">
              <span class="play-number">{play.number}</span>
              <h3>{play.title}</h3>
              <p>{play.body}</p>
              <div class="play-example">{play.example}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section handoff-section texture-hybrid" id="sales-handoff">
      <div class="container handoff-grid">
        <div class="handoff-copy">
          <span class="eyebrow">What sales actually receives</span>
          <h2>A reply is only valuable if someone knows <span class="italic-accent">what to do next.</span></h2>
          <p class="lead">We classify interest, route it to an owner, and keep the reason for outreach, buyer context, and conversation history together in the CRM.</p>
          <p>When a buyer responds, sales can continue the conversation rather than restart discovery from a blank contact record.</p>
        </div>
        <div class="handoff-record" aria-label="Illustrative qualified lead handoff">
          <div class="record-header"><span>ILLUSTRATIVE HANDOFF</span><span class="record-status"><span aria-hidden="true"></span> READY FOR SALES</span></div>
          <div class="record-main"><span class="record-avatar" aria-hidden="true">AC</span><div><strong>Qualified buyer</strong><small>Target account · decision-maker</small></div></div>
          <div class="record-row"><span>WHY NOW</span><p>Recent engagement and a relevant account-level change</p></div>
          <div class="record-row"><span>MESSAGE CONTEXT</span><p>The problem discussed, the offer made, and the buyer's response</p></div>
          <div class="record-row"><span>NEXT ACTION</span><p>Assigned owner, suggested follow-up, and CRM history</p></div>
        </div>
      </div>
    </section>

    <section class="section proof-section" id="customer-proof">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">Customer results</span>
          <h2>Different markets. Systems built around <span class="italic-accent">what moves buyers.</span></h2>
          <p class="lead">These outcomes came from broader outbound and GTM engagements. Each story shows the market problem, the system we built, and the result.</p>
        </div>
        <div class="proof-grid">
          <article class="proof-card">
            <img src="/logos/blueprint-white.png" alt="Blueprint" loading="lazy" />
            <span class="proof-type">Global market expansion</span>
            <h3>30-40 qualified meetings a month. More than $10M in closed revenue.</h3>
            <p>Blueprint had tried AI tools and manual research. We built a global outbound motion that found the right buyers across 30 countries and moved them into qualified conversations.</p>
            <a href="/customer-results/blueprint" class="text-link">Read the Blueprint story <span aria-hidden="true">→</span></a>
          </article>
          <article class="proof-card">
            <img src="/logos/bound-white.avif" alt="Bound" loading="lazy" />
            <span class="proof-type">Repeatable outbound engine</span>
            <h3>A seven-figure pipeline doubled in 90 days.</h3>
            <p>Bound moved from manual list building and unclear reporting to defined targeting, signal-informed campaigns, execution, and HubSpot visibility.</p>
            <a href="/customer-results/bound" class="text-link">Read the Bound story <span aria-hidden="true">→</span></a>
          </article>
          <article class="proof-card">
            <img src="/logos/condenzero-white.png" alt="CondenZero" loading="lazy" />
            <span class="proof-type">Focused campaign</span>
            <h3>$2.4M in pipeline from one conference.</h3>
            <p>CondenZero had a small, hard-to-find buyer universe. We identified likely attendees, prioritized relevant people, and started conversations before the event.</p>
            <a href="/customer-results/condenzero" class="text-link">Read the CondenZero story <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="section engagement-section texture-glow" id="engagement">
      <div class="container">
        <div class="section-heading">
          <span class="eyebrow">How we work together</span>
          <h2>Get the engine built. Then choose <span class="italic-accent">who runs it.</span></h2>
          <p class="lead">The strategy, data, messaging, sending, routing, and reporting need to work together in either model. The difference is how much ongoing execution your team wants to own.</p>
        </div>
        <div class="engagement-grid">
          <article class="engagement-card"><span class="engagement-label">01 / BUILD WITH YOUR TEAM</span><h3>Build the engine</h3><p>We design and implement the motion in your stack, launch the first plays, and enable your team to operate and improve it.</p><span class="engagement-best">For teams with capacity to take over execution.</span></article>
          <article class="engagement-card"><span class="engagement-label">02 / BUILD AND RUN</span><h3>Run the execution layer</h3><p>We build the system and keep operating the research, campaigns, monitoring, routing, and experiments alongside your sales team.</p><span class="engagement-best">For teams that want an external GTM engineering function.</span></article>
        </div>
        <div class="engagement-action"><a href={meetingUrl} class="btn btn-accent btn-md">Talk through your outbound system</a></div>
      </div>
    </section>

    <section class="section faq-section" id="questions">
      <div class="container faq-grid">
        <div class="faq-intro"><span class="eyebrow">Before we start</span><h2>Common questions.</h2><p>Not sure where your current outbound system is leaking? The <a href="/resources/gtm-audit">Allbound Audit</a> looks at the wider GTM motion.</p></div>
        <div class="faq-list">
          {questions.map((item) => (
            <details class="faq-item"><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="section final-section texture-hybrid">
      <div class="container final-inner">
        <span class="eyebrow">Build a better outbound motion</span>
        <h2>Protect your market. Find the right moments. <span class="italic-accent">Start better conversations.</span></h2>
        <p class="lead">Book a GTM session. We will look at your market, current outbound, and the first part of the system worth fixing.</p>
        <a href={meetingUrl} class="btn btn-accent btn-md">Book a GTM session</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(.outbound-service section.section) { padding-block: 72px; }
  :global(.outbound-service .eyebrow) { color: var(--color-accent); }
  .hero { --texture-base: var(--color-canvas); padding: 72px 0 64px; border-bottom: 1px solid var(--color-border); }
  .hero-grid { display: grid; grid-template-columns: 1.12fr .88fr; gap: var(--space-7); align-items: center; }
  .hero h1 { max-width: 760px; margin-top: var(--space-4); font-size: clamp(2.7rem, 5vw, 4.6rem); }
  .hero .lead { max-width: 650px; margin-top: var(--space-5); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-5); align-items: center; margin-top: var(--space-6); }
  .text-link { display: inline-flex; gap: var(--space-2); align-items: center; width: fit-content; color: var(--color-accent); font-weight: 700; text-decoration: none; }
  .text-link:hover { color: var(--color-accent-hover); text-decoration: underline; text-underline-offset: 4px; }
  .fit-note { max-width: 620px; margin-top: var(--space-5); color: var(--color-body); font-size: .92rem; }
  .hero-visual { padding: var(--space-5); border: 1px solid var(--color-border-strong); border-top: 3px solid var(--color-accent); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-md); }
  .visual-top, .visual-footer { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); font: 700 .68rem var(--font-mono); letter-spacing: .06em; }
  .visual-top { margin-bottom: var(--space-5); }
  .visual-kicker { color: var(--color-accent); text-transform: uppercase; }
  .visual-live { display: inline-flex; align-items: center; gap: 7px; color: var(--color-positive); white-space: nowrap; }
  .visual-live span, .record-status span { width: 6px; height: 6px; border-radius: 50%; background: var(--color-positive); }
  .visual-account, .visual-signal, .visual-conversation { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-raised); }
  .visual-account strong, .visual-signal strong, .visual-conversation strong, .record-main strong { display: block; color: var(--color-heading); line-height: 1.2; }
  .visual-account small, .visual-signal small, .visual-conversation small, .record-main small { display: block; margin-top: 4px; color: var(--color-body); font-size: .8rem; }
  .account-avatar, .signal-icon, .conversation-icon { display: grid; flex: 0 0 38px; width: 38px; height: 38px; place-items: center; border-radius: 50%; background: var(--color-accent); color: white; font-weight: 700; }
  .signal-icon { background: var(--color-flow-strong); font-size: 1.3rem; }
  .conversation-icon { background: var(--color-positive); font-size: 1.3rem; }
  .visual-check { margin-left: auto; color: var(--color-positive); font-weight: 800; }
  .visual-line { height: 22px; margin-left: 34px; border-left: 1px solid var(--color-border-strong); }
  .visual-footer { justify-content: center; margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--color-border); color: var(--color-body); }
  .visual-footer span:nth-child(even) { color: var(--color-positive); }
  .section-heading { max-width: 820px; margin-bottom: var(--space-6); }
  .section-heading h2, .handoff-copy h2, .faq-intro h2 { margin-top: var(--space-3); font-size: clamp(2.05rem, 4vw, 3.1rem); }
  .section-heading .lead, .handoff-copy .lead { margin-top: var(--space-3); }
  .problems-section, .plays-section, .proof-section, .faq-section { background: var(--color-canvas); }
  .problem-grid, .steps-grid, .plays-grid, .proof-grid, .engagement-grid { display: grid; gap: var(--space-4); }
  .problem-grid, .steps-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .problem-card, .step-card, .play-card, .proof-card, .engagement-card { padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); }
  .problem-card { min-height: 226px; border-top: 2px solid var(--color-accent); }
  .card-number, .step-number, .play-number, .engagement-label, .proof-type { font: 700 .73rem var(--font-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--color-accent); }
  .problem-card h3, .step-card h3, .play-card h3, .proof-card h3, .engagement-card h3 { margin-top: var(--space-4); font-size: 1.45rem; line-height: 1.18; }
  .problem-card p, .step-card p, .play-card p, .proof-card p, .engagement-card p { margin-top: var(--space-3); color: var(--color-body); }
  .diagnostic-link { margin-top: var(--space-5); }
  .process-section { --texture-base: var(--color-surface); }
  .step-card { display: flex; flex-direction: column; border-top: 2px solid var(--color-accent); background: var(--color-canvas); }
  .step-number { display: grid; width: 36px; height: 36px; place-items: center; border-radius: 50%; background: var(--color-accent); color: white; }
  .step-output { display: flex; gap: var(--space-2); align-items: baseline; margin-top: auto; padding-top: var(--space-4); color: var(--color-heading); font-weight: 700; }
  .step-output span { color: var(--color-accent); }
  .plays-grid, .proof-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .play-card { display: flex; flex-direction: column; }
  .play-example { margin-top: auto; padding-top: var(--space-5); color: var(--color-heading); font-size: .9rem; }
  .handoff-section { --texture-base: var(--color-surface); }
  .handoff-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: var(--space-7); align-items: center; }
  .handoff-copy p:not(.lead) { max-width: 580px; margin-top: var(--space-4); }
  .handoff-record { overflow: hidden; border: 1px solid var(--color-border-strong); border-radius: var(--radius-md); background: var(--color-canvas); box-shadow: var(--shadow-md); }
  .record-header { display: flex; justify-content: space-between; gap: var(--space-2); padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--color-border); color: var(--color-body); font: 700 .68rem var(--font-mono); letter-spacing: .05em; }
  .record-status { display: inline-flex; align-items: center; gap: 8px; color: var(--color-positive); white-space: nowrap; }
  .record-main { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-5); border-bottom: 1px solid var(--color-border); }
  .record-avatar { display: grid; width: 46px; height: 46px; place-items: center; border-radius: var(--radius-sm); background: var(--color-accent); color: white; font-weight: 800; }
  .record-row { display: grid; grid-template-columns: 132px 1fr; gap: var(--space-4); padding: var(--space-4) var(--space-5); border-bottom: 1px solid var(--color-border); }
  .record-row:last-child { border-bottom: 0; }
  .record-row span { color: var(--color-accent); font: 700 .68rem var(--font-mono); letter-spacing: .05em; }
  .record-row p { margin: 0; color: var(--color-heading); font-size: .92rem; }
  .proof-card { display: flex; flex-direction: column; }
  .proof-card img { width: auto; max-width: 150px; height: 27px; object-fit: contain; object-position: left center; margin-bottom: var(--space-5); }
  .proof-card h3 { min-height: 100px; }
  .proof-card .text-link { margin-top: auto; padding-top: var(--space-5); }
  .engagement-section { --texture-base: var(--color-surface); }
  .engagement-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .engagement-card { background: var(--color-canvas); border-top: 2px solid var(--color-accent); }
  .engagement-best { display: block; margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--color-border); color: var(--color-heading); font-weight: 700; }
  .engagement-action { margin-top: var(--space-5); }
  .faq-grid { display: grid; grid-template-columns: .75fr 1.25fr; gap: var(--space-7); }
  .faq-intro p { margin-top: var(--space-4); }
  .faq-intro a { color: var(--color-accent); }
  .faq-item { border-bottom: 1px solid var(--color-border); }
  .faq-item:first-child { border-top: 1px solid var(--color-border); }
  .faq-item summary { display: flex; justify-content: space-between; gap: var(--space-4); padding: var(--space-4) 0; color: var(--color-heading); font-size: 1.05rem; font-weight: 700; cursor: pointer; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary span { color: var(--color-accent); font-size: 1.3rem; line-height: 1; }
  .faq-item[open] summary span { transform: rotate(45deg); }
  .faq-item p { padding-bottom: var(--space-4); }
  .final-section { --texture-base: var(--color-surface); text-align: center; }
  .final-inner { max-width: 880px; }
  .final-inner h2 { margin-top: var(--space-3); font-size: clamp(2.2rem, 4.5vw, 3.5rem); }
  .final-inner .lead { margin: var(--space-4) auto var(--space-5); max-width: 670px; }
  @media (max-width: 1023px) {
    .hero-grid, .handoff-grid { grid-template-columns: 1fr; gap: var(--space-6); }
    .hero-visual { max-width: 650px; }
    .plays-grid, .proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    :global(.outbound-service section.section) { padding-block: 56px; }
    .hero { padding: 56px 0; }
    .hero h1 { font-size: clamp(2.5rem, 10vw, 3.5rem); }
