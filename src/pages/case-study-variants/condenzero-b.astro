---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title =
  "How CondenZero generated $2.4 million in pipeline from a single conference";
const metrics = [
  { value: "650", label: "People reached" },
  { value: "22", label: "Meetings booked" },
  { value: "$2.4M", label: "Pipeline generated" },
  { value: "$300K", label: "Deal closed" },
];
---

<BaseLayout title={`${title} - Variant B`} description="Condensed case study top section variant.">
  <main class="case-variant case-variant-b">
    <section class="case-variant-hero section">
      <div class="container">
        <div class="case-variant-header">
          <h1>
            <span>How CondenZero generated $2.4 million</span>
            <span>in pipeline from a single conference</span>
          </h1>
        </div>

        <div class="case-variant-video clean-video">
          <span class="case-variant-play">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </span>
        </div>

        <div class="case-variant-proof-split">
          <div class="case-variant-proof-left">
            <div class="case-variant-company-lockup">
              <span class="case-variant-company-logo">CZ</span>
              <span>CondenZero</span>
            </div>
            <div class="case-variant-metrics editorial">
              {metrics.map((metric) => (
                <div class="case-variant-metric">
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </div>
              ))}
            </div>
          </div>

          <blockquote class="case-variant-quote denys-inline">
            <div class="case-variant-person-row">
              <div class="case-variant-person-photo">DS</div>
              <footer>Denys Sutter · Founder, CondenZero</footer>
            </div>
            <p>
              "The collaboration was very pragmatic and clearly structured.
              Absolute 10 out of 10."
            </p>
          </blockquote>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
