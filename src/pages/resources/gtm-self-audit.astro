---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarqueeLogoWall from "../../components/MarqueeLogoWall.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import FAQ from "../../components/FAQ.astro";
import { getCollection } from "astro:content";
import { questions } from "../../lib/allboundAudit";

const meetingUrl = "https://revenue.enablement.ch/meetings/l-heiz/firstmeeting";
const proofOrder = ["blueprint", "ekipa", "bound"];
const proofStudies = (await getCollection("caseStudies"))
  .filter((study) => study.data.live && proofOrder.includes(study.id))
  .sort((a, b) => proofOrder.indexOf(a.id) - proofOrder.indexOf(b.id));
const faq = [
  { q: "Is the self audit free?", a: "Yes. Answer eight questions and see your score, two main gaps, and a first action immediately. No email address is required." },
  { q: "Is the score a benchmark against other companies?", a: "No. It is a directional self assessment based on your answers. It helps you find possible gaps, but it cannot validate your data, process, or revenue impact." },
  { q: "What happens in the Allbound Audit call?", a: "In a free 30-minute session, Lanny reviews your go-to-market motion and numbers with you, checks where opportunities are lost, and prioritizes the bottlenecks. The team sends a written diagnosis within 24 hours." },
  { q: "What should I bring to the call?", a: "Bring the numbers you have for marketing activity, inbound, outbound, replies, meetings, opportunities, closed deals, and sales cycle. Incomplete data is fine and often useful to discuss." },
  { q: "Do I need to give you CRM access?", a: "No. You can talk through your numbers or share a dashboard during the session if you find it useful." },
];
---

<BaseLayout
  title="Free GTM Self Audit | Enablement.ch"
  description="Answer eight questions to see where your go-to-market system may be losing revenue. Get an immediate score and next steps."
>
  <header class="self-hero texture-hybrid">
    <div class="container hero-inner">
      <span class="eyebrow">↳ Free GTM Self Audit</span>
      <h1 class="display">Find where your GTM system <span class="italic-accent">loses revenue.</span></h1>
      <p class="lead">Eight specific questions. An immediate score, your two biggest gaps, and a useful first step. No email required.</p>
      <a href="#self-audit" class="btn btn-accent btn-lg">Start the self audit</a>
      <span class="hero-note">About 3 minutes · No signup · Directional score</span>
    </div>
  </header>

  <section class="section quiz-section" id="self-audit">
    <div class="container">
      <div class="quiz-heading">
        <div>
          <span class="eyebrow">The diagnostic</span>
          <h2>How connected is your <span class="italic-accent">GTM system?</span></h2>
          <p>Choose Yes, Partly, or No against the standard shown. Answer for what happens consistently today.</p>
        </div>
        <span class="question-progress" id="question-progress" aria-live="polite">Question 1 of 8</span>
      </div>

      <div class="quiz-shell" id="quiz-shell">
        <div class="progress-track" aria-hidden="true"><span id="progress-fill"></span></div>
        {questions.map((item, index) => (
          <fieldset class="question-panel" data-question={index} hidden={index !== 0}>
            <legend class="sr-only">Question {index + 1}: {item.question}</legend>
            <span class="question-stage">{item.stage}</span>
            <h3 aria-hidden="true">{item.question}</h3>
            <p class="yes-standard"><strong>Yes means</strong> {item.yes}</p>
            <div class="answer-options" aria-label={`Answer question ${index + 1}`}>
              {(["yes", "partly", "no"] as const).map((answer) => (
                <label class="answer-option">
                  <input type="radio" name={`question-${index}`} value={answer} />
                  <span>{answer === "yes" ? "Yes" : answer === "partly" ? "Partly" : "No"}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
        <div class="quiz-controls">
          <button class="btn btn-secondary btn-md" id="quiz-back" type="button" hidden>Back</button>
          <span id="quiz-error" role="alert" aria-live="polite"></span>
          <button class="btn btn-accent btn-md" id="quiz-next" type="button">Next question</button>
        </div>
      </div>

      <div class="result-shell" id="audit-result" hidden tabindex="-1">
        <span class="eyebrow">Your GTM Self Audit</span>
        <div class="result-top">
          <div><h2 id="result-headline"></h2><p id="result-summary"></p></div>
          <div class="score-badge"><strong id="result-score"></strong><span>out of 100</span></div>
        </div>
        <p class="score-caveat">This is a directional self assessment based on your answers, not a validated benchmark or a revenue forecast.</p>
        <h3 id="gap-section-heading">Your two biggest gaps to close</h3>
        <div class="gap-grid" id="result-gaps"></div>
        <div class="result-actions">
          <a href={meetingUrl} class="btn btn-accent btn-lg" data-audit-booking>Book a free Allbound Audit</a>
          <a href="#what-happens" class="text-link">What happens in the audit ↓</a>
        </div>
        <button class="restart-link" id="quiz-restart" type="button">Retake the self audit</button>
      </div>
    </div>
  </section>

  <MarqueeLogoWall />

  <section class="section audit-process-section texture-glow" id="what-happens">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">The next step</span>
        <h2>The self audit finds a pattern. The call finds <span class="italic-accent">the cause.</span></h2>
        <p class="lead">The free Allbound Audit goes deeper into your actual motion and numbers, so you know what deserves attention first.</p>
      </div>
      <div class="step-grid">
        <article><span>01 / Map</span><h3>Walk the system</h3><p>In 30 minutes, Lanny maps your targeting, content, outreach, lead handling, sales process, and reporting with you.</p></article>
        <article><span>02 / Diagnose</span><h3>Locate the bottleneck</h3><p>We use the numbers and examples you have to identify where fit, context, speed, or buyer commitment breaks down.</p></article>
        <article><span>03 / Prioritize</span><h3>Get a written plan</h3><p>Within 24 hours, you receive a written diagnosis with the bottlenecks, evidence, and order of the next fixes.</p></article>
      </div>
      <div class="process-action"><a href={meetingUrl} class="btn btn-accent btn-md" data-audit-booking>Book a free Allbound Audit</a><span>Free · 30 minutes · Written diagnosis within 24 hours</span></div>
    </div>
  </section>

  <section class="section proof-section">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">Customer results</span><h2>See what changed when the gaps <span class="italic-accent">were fixed.</span></h2><p class="lead">These are examples from broader customer engagements. Your self audit result is a starting hypothesis, not a claim that the same outcome will follow.</p></div>
      <div class="case-grid">{proofStudies.map((study) => <CaseStudyCard cs={study} />)}</div>
    </div>
  </section>

  <section class="section authority-section">
    <div class="container authority-layout">
      <div><span class="eyebrow">Who you will speak with</span><h2>Lanny turns the conversation into a clear diagnosis.</h2><p>Lanny Heiz, Enablement's Co-Founder and GTM Advisor, runs the audit and writes the priority order. Gilbert Kralinger leads the technical architecture when the solution requires implementation.</p></div>
      <div class="founder-card"><img src="/team/lanny.png" alt="Lanny Heiz" width="104" height="104" loading="lazy" /><div><strong>Lanny Heiz</strong><span>Co-Founder and GTM Advisor</span><a href="https://www.linkedin.com/in/lanny-heiz/" target="_blank" rel="noopener">View Lanny on LinkedIn ↗</a></div></div>
    </div>
  </section>

  <FAQ eyebrow="Before you book" headline="What to expect from the audit." questions={faq} />

  <section class="section final-section" id="book-audit">
    <div class="container final-inner"><span class="eyebrow">The Allbound Audit</span><h2>Know what to fix <span class="italic-accent">first.</span></h2><p class="lead">A free conversation about your real GTM system, followed by a written diagnosis within 24 hours.</p><a href={meetingUrl} class="btn btn-accent btn-lg" data-audit-booking>Book a free Allbound Audit</a></div>
  </section>

  <script>
    import { questions, scoreAudit, type Answer } from "../../lib/allboundAudit";
    const shell = document.querySelector<HTMLElement>("#quiz-shell")!;
    const result = document.querySelector<HTMLElement>("#audit-result")!;
    const panels = Array.from(document.querySelectorAll<HTMLElement>(".question-panel"));
    const answers: (Answer | null)[] = Array(questions.length).fill(null);
    const progress = document.querySelector<HTMLElement>("#question-progress")!;
    const fill = document.querySelector<HTMLElement>("#progress-fill")!;
    const back = document.querySelector<HTMLButtonElement>("#quiz-back")!;
    const next = document.querySelector<HTMLButtonElement>("#quiz-next")!;
    const error = document.querySelector<HTMLElement>("#quiz-error")!;
    let current = 0;

    function track(event: string, properties: Record<string, string | number> = {}) {
      const syft = (window as Window & { syft?: { track?: (event: string, properties: Record<string, string | number>) => void } }).syft;
      syft?.track?.(event, properties);
    }

    function showQuestion(index: number) {
      current = index;
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
      progress.textContent = `Question ${index + 1} of ${questions.length}`;
      fill.style.width = `${((index + 1) / questions.length) * 100}%`;
      back.hidden = index === 0;
      next.textContent = index === questions.length - 1 ? "See my results" : "Next question";
      error.textContent = "";
      panels[index].querySelector<HTMLInputElement>("input:checked")?.focus();
    }

    document.querySelector("#self-audit")?.addEventListener("change", (event) => {
      const input = event.target as HTMLInputElement;
      if (!input.matches('input[type="radio"]')) return;
      answers[current] = input.value as Answer;
      error.textContent = "";
      if (current === 0) track("gtm_self_audit_started");
    });
    back.addEventListener("click", () => showQuestion(current - 1));
    next.addEventListener("click", () => {
      if (!answers[current]) { error.textContent = "Choose an answer to continue."; return; }
      if (current < questions.length - 1) { showQuestion(current + 1); return; }
      const outcome = scoreAudit(answers);
      const copy = outcome.band === "critical"
          ? ["Your GTM system has major gaps.", "Several connections between buyer interest and revenue need attention. Start with the two largest gaps below."]
        : outcome.band === "developing"
          ? ["Some parts work. Others may leak revenue.", "Your answers point to a functioning motion with gaps that may be limiting conversion or learning."]
          : ["Your GTM system looks connected.", "You report strong coverage across the core stages. Validate the answers against recent deals and keep refining the weaker spots."];
      document.querySelector<HTMLElement>("#result-headline")!.textContent = copy[0];
      document.querySelector<HTMLElement>("#result-summary")!.textContent = copy[1];
      document.querySelector<HTMLElement>("#result-score")!.textContent = String(outcome.score);
      result.dataset.band = outcome.band;
      const gaps = document.querySelector<HTMLElement>("#result-gaps")!;
      gaps.replaceChildren();
      const opportunities = outcome.gaps.length ? outcome.gaps : questions.slice(0, 2).map((question) => ({ ...question, answer: "yes" as const, loss: 0 }));
      document.querySelector<HTMLElement>("#gap-section-heading")!.textContent = outcome.gaps.length ? "Your two biggest gaps to close" : "Two strengths worth validating";
      opportunities.forEach((item, index) => {
        const card = document.createElement("article");
        card.className = "gap-card";
        const label = document.createElement("span"); label.className = "gap-label"; label.textContent = `0${index + 1}`;
        const title = document.createElement("h4"); title.textContent = item.gap;
        const challenge = document.createElement("p"); challenge.className = "gap-challenge"; challenge.textContent = item.challenge;
        const impact = document.createElement("p"); impact.className = "gap-impact"; impact.textContent = item.loss ? item.impact : "Check this against recent deals to confirm the process works consistently.";
        const action = document.createElement("p"); action.className = "gap-action"; action.textContent = item.action;
        card.append(label, title, challenge, impact, action); gaps.append(card);
      });
      shell.hidden = true; result.hidden = false; progress.hidden = true;
      track("gtm_self_audit_completed", { score: outcome.score, band: outcome.band, biggest_gap: opportunities[0]?.id ?? "none" });
      result.focus();
    });
    document.querySelector("#quiz-restart")?.addEventListener("click", () => {
      answers.fill(null);
      document.querySelectorAll<HTMLInputElement>('.question-panel input[type="radio"]').forEach((input) => { input.checked = false; });
      result.hidden = true; shell.hidden = false; progress.hidden = false; showQuestion(0); shell.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    document.querySelectorAll<HTMLAnchorElement>("[data-audit-booking]").forEach((link) => link.addEventListener("click", () => track("gtm_self_audit_booking_click", { location: link.closest("section")?.id || "result" })));
  </script>

  <style>
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
    .self-hero { padding: 116px 0 90px; border-bottom: 1px solid var(--color-border); text-align: center; }
    .hero-inner { display: flex; flex-direction: column; align-items: center; }
    .self-hero h1 { max-width: 900px; margin: 16px auto 18px; line-height: 1.06; }
    .self-hero .lead { max-width: 650px; margin: 0 auto 30px; }
    .hero-note { margin-top: 15px; font: 12px var(--font-mono); color: var(--color-muted); }
    .quiz-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 28px; }
    .quiz-heading h2, .section-heading h2 { margin: 8px 0 12px; }
    .quiz-heading p { margin: 0; max-width: 650px; }
    .question-progress, .question-stage, .gap-label, .step-grid article > span { font: 12px var(--font-mono); color: var(--color-muted); text-transform: uppercase; letter-spacing: .04em; }
    .question-progress { white-space: nowrap; }
    .quiz-shell, .result-shell { background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--radius-lg); padding: clamp(24px, 5vw, 52px); max-width: 920px; margin: 0 auto; }
    .progress-track { height: 3px; background: var(--color-border); margin: -2px 0 35px; }
    .progress-track span { display: block; height: 100%; width: 12.5%; background: var(--color-accent); transition: width .2s; }
    .question-panel { border: 0; margin: 0; padding: 0; min-width: 0; width: 100%; }
    .question-panel h3 { font-size: clamp(27px, 4vw, 39px); line-height: 1.15; color: var(--color-heading); margin: 18px 0 20px; max-width: 760px; }
    .yes-standard { max-width: 740px; margin: 0 0 32px; padding: 15px 19px; background: var(--color-surface-raised); border-left: 3px solid var(--color-accent); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
    .yes-standard strong { color: var(--color-heading); margin-right: 5px; }
    .answer-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
    .answer-option { cursor: pointer; position: relative; }
    .answer-option input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
    .answer-option span { display: block; text-align: center; padding: 16px; border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); color: var(--color-heading); font-weight: 700; background: var(--color-canvas); transition: border-color .15s, background .15s; }
    .answer-option input:hover + span, .answer-option input:focus-visible + span { border-color: var(--color-accent); }
    .answer-option input:focus-visible + span { outline: 2px solid var(--color-heading); outline-offset: 2px; }
    .answer-option input:checked + span { border-color: var(--color-accent); background: #3b2028; color: #fff; }
    .quiz-controls { display: flex; align-items: center; justify-content: flex-end; gap: 14px; margin-top: 32px; }
    .quiz-controls #quiz-back:not([hidden]) { margin-right: auto; }
    #quiz-error { color: #ff9b9b; font-size: 14px; }
    .result-shell { outline: none; }
    .result-top { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin: 16px 0; }
    .result-top h2 { margin: 0 0 10px; line-height: 1.14; }
    .result-top p { margin: 0; max-width: 600px; }
    .score-badge { width: 128px; height: 128px; border: 2px solid var(--color-warning); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 0 0 auto; }
    .score-badge strong { font-size: 52px; color: var(--color-heading); line-height: 1; }
    .score-badge span { font: 11px var(--font-mono); }
    [data-band="critical"] .score-badge { border-color: var(--color-critical); }
    [data-band="connected"] .score-badge { border-color: var(--color-positive); }
    .score-caveat { font-size: 13px; color: var(--color-muted); padding-bottom: 24px; border-bottom: 1px solid var(--color-border); }
    .result-shell h3 { margin: 28px 0 16px; }
    .gap-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .gap-card, .step-grid article, .founder-card { background: var(--color-surface-raised); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 24px; }
    .gap-card { border-top: 2px solid var(--color-accent); }
    .gap-card h4 { color: var(--color-heading); font-size: clamp(23px, 2.5vw, 28px); line-height: 1.2; margin: 12px 0 12px; }
    .gap-card p { margin: 0; }
    .gap-challenge { color: var(--color-heading); font-size: 18px; line-height: 1.35; font-weight: 600; }
    .gap-impact { margin-top: 16px !important; }
    .gap-action { margin-top: 18px !important; padding-top: 16px; border-top: 1px solid var(--color-border); font-size: 14px; }
    .gap-action::before { content: "First move"; display: block; margin-bottom: 5px; color: var(--color-accent); font: 12px var(--font-mono); text-transform: uppercase; letter-spacing: .04em; }
    .result-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 20px; margin-top: 28px; }
    .text-link, .founder-card a { color: var(--color-heading); text-decoration-color: var(--color-accent); text-underline-offset: 5px; }
    .restart-link { display: block; margin-top: 25px; background: none; border: 0; color: var(--color-muted); padding: 0; text-decoration: underline; cursor: pointer; font: inherit; }
    .section-heading { max-width: 800px; margin-bottom: 32px; }
    .step-grid, .case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .step-grid article { background: var(--color-surface); border-top: 2px solid var(--color-accent); }
    .step-grid h3 { color: var(--color-heading); font-size: 23px; margin: 16px 0 8px; }
    .step-grid p { margin: 0; }
    .process-action { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; margin-top: 28px; }
    .process-action span { color: var(--color-muted); font: 12px var(--font-mono); }
    .authority-layout { display: grid; grid-template-columns: 1.5fr 1fr; align-items: center; gap: 40px; }
    .authority-layout h2 { margin: 8px 0 14px; }
    .authority-layout p { margin: 0; }
    .founder-card { display: flex; align-items: center; gap: 20px; }
    .founder-card img { object-fit: cover; border-radius: 50%; }
    .founder-card strong, .founder-card span, .founder-card a { display: block; }
    .founder-card strong { color: var(--color-heading); font-size: 20px; }
    .founder-card span { margin-bottom: 10px; }
    .final-section { text-align: center; background: var(--color-surface); }
    .final-inner { display: flex; flex-direction: column; align-items: center; }
    .final-inner h2 { margin: 12px 0; }
    .final-inner p { max-width: 600px; margin: 0 0 28px; }
    [hidden] { display: none !important; }
    @media (max-width: 760px) {
      .self-hero { padding: 80px 0 64px; }
      .quiz-heading, .result-top { align-items: start; flex-direction: column; }
      .answer-options, .gap-grid, .step-grid, .case-grid, .authority-layout { grid-template-columns: 1fr; }
      .score-badge { width: 104px; height: 104px; }
      .score-badge strong { font-size: 42px; }
      .quiz-controls { flex-wrap: wrap; }
      .quiz-controls #quiz-next { width: 100%; }
    }
  </style>
</BaseLayout>
