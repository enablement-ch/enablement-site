---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarqueeLogoWall from "../../components/MarqueeLogoWall.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import FAQ from "../../components/FAQ.astro";
import { getCollection } from "astro:content";

const meetingUrl = "https://revenue.enablement.ch/meetings/l-heiz/firstmeeting";
const proof = (await getCollection("caseStudies")).find((study) => study.id === "ekipa");
const faq = [
  { q: "Is this a generic competitor list?", a: "No. We start with your website, find firms that sell a similar service or product to similar buyers, then check what their founders publish." },
  { q: "Will I see this immediately?", a: "The analysis starts after Clay enriches your request. Keep this page open to see its progress and the results. It can take several minutes." },
  { q: "Do I need to be connected with you on LinkedIn?", a: "No. Your LinkedIn profile URL gives us a starting point for the analysis." },
  { q: "What happens on the call?", a: "In a free 30-minute LinkedIn System Audit, we review the content gap, the buyer problems you can credibly speak to, and how to turn relevant engagement into sales conversations." },
];
---

<BaseLayout noindex title="LinkedIn Analysis | Find your content gap" description="See what relevant competitors publish on LinkedIn, which buyer topics they own, and where your team could earn attention. Request a personal analysis.">
  <header class="pull-hero texture-hybrid">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">↳ Free LinkedIn Analysis</span>
        <h1 class="display">Your competitors are teaching your buyers. <span class="italic-accent">What are you missing?</span></h1>
        <p class="lead">See what relevant companies publish on LinkedIn, which ideas already win attention, and the buyer problems your team could credibly own.</p>
        <a href="#request-analysis" class="btn btn-accent btn-lg">Find my content gap</a>
        <span class="hero-note">Your profile + company domain · Results on this page</span>
      </div>
      <div class="report-preview" aria-label="Example of the analysis sections">
        <div class="preview-top"><span>CONTENT GAP / PREVIEW</span><span>↗</span></div>
        <div class="preview-main"><span class="preview-kicker">THE QUESTION</span><strong>What could your buyers learn from you that they cannot learn from a competitor?</strong></div>
        <div class="preview-row"><span>01</span><div><strong>The people publishing</strong><small>Relevant voices, not a random company list</small></div></div>
        <div class="preview-row"><span>02</span><div><strong>The topics they own</strong><small>Posts and engagement behind the pattern</small></div></div>
        <div class="preview-row"><span>03</span><div><strong>Your credible opening</strong><small>Buyer problems your own offer can support</small></div></div>
      </div>
    </div>
  </header>

  <section class="section request-section" id="request-analysis">
    <div class="container request-grid">
      <div class="request-intro">
        <span class="eyebrow">The analysis</span>
        <h2>Find the gap you can <span class="italic-accent">actually claim.</span></h2>
        <p>We read your website and profile, find comparable businesses, and review their founders' recent posts. The findings appear here with sources and a practical place to start.</p>
        <div class="request-steps">
          <div><span>01 / Compare</span><strong>Who is active in your category?</strong></div>
          <div><span>02 / Diagnose</span><strong>Which topics are crowded or missing?</strong></div>
          <div><span>03 / Act</span><strong>What should you publish and who should follow up?</strong></div>
        </div>
      </div>
      <form class="request-form" id="competitor-request-form">
        <span class="eyebrow">Request your report</span>
        <h3>What should we analyse?</h3>
        <label>Your LinkedIn profile<input name="linkedinUrl" type="url" inputmode="url" autocomplete="url" placeholder="https://www.linkedin.com/in/your-name/" required /></label>
        <label>Company domain<input name="companyDomain" inputmode="url" placeholder="company.com" required /></label>
        <div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button type="submit" class="btn btn-accent btn-lg">Analyse my content gap</button>
        <p class="form-note">Your analysis will appear here after the enrichment and research finish. This may take several minutes.</p>
        <p class="form-status" id="competitor-request-status" role="status" aria-live="polite"></p>
      </form>
      <div class="request-success" id="analysis-progress" hidden tabindex="-1">
        <span class="eyebrow">Your LinkedIn Analysis</span>
        <h3 id="analysis-progress-title">Preparing your analysis</h3>
        <p id="analysis-progress-message" role="status" aria-live="polite">We received your request.</p>
        <div class="analysis-wait" id="analysis-wait"><span class="wait-dial" aria-hidden="true"></span><span>Research in progress <strong id="analysis-elapsed">00:00</strong></span></div>
        <p class="analysis-stay" id="analysis-stay">Do not close this page while your analysis is being prepared.</p>
        <div id="analysis-results" hidden></div>
        <button type="button" class="btn btn-outline btn-md" id="analysis-start-over" hidden>Start another analysis</button>
      </div>
    </div>
  </section>

  <section class="section finding-section texture-glow">
    <div class="container finding-grid">
      <div><span class="eyebrow">Why this matters</span><h2>More posting is rarely <span class="italic-accent">the diagnosis.</span></h2></div>
      <div><p>If everyone teaches the same tactics, your posts make the category louder without making your company easier to choose. If nobody teaches the buyer, the opening may be wider than you think.</p><p>The useful question is which buyer problem your team can explain from direct experience, then whether the right accounts see it and have a reason to talk.</p></div>
    </div>
  </section>

  <MarqueeLogoWall />

  <section class="section audit-section" id="linkedin-audit">
    <div class="container">
      <div class="section-heading"><span class="eyebrow">The next step</span><h2>The report finds the opening. The call builds <span class="italic-accent">the system.</span></h2><p class="lead">This quick automated scan uses public content. In a free 30-minute LinkedIn System Audit, we look deeper at your positioning, content that earns relevant attention, and how to turn that attention into sales conversations.</p></div>
      <div class="audit-grid">
        <article><span>01 / Position</span><h3>Choose the buyer problem</h3><p>Check which topic your team can own with real expertise and proof.</p></article>
        <article><span>02 / Publish</span><h3>Build the content motion</h3><p>Turn that point of view into posts that earn attention from the right people.</p></article>
        <article><span>03 / Convert</span><h3>Act on the right signals</h3><p>Qualify the people who engage and create a relevant reason for sales to speak with them.</p></article>
      </div>
      <a href={meetingUrl} class="btn btn-accent btn-md">Book my free LinkedIn audit</a>
    </div>
  </section>

  {proof && <section class="section proof-section"><div class="container proof-grid"><div><span class="eyebrow">Customer proof</span><h2>Content can open <span class="italic-accent">real deals.</span></h2><p>Ekipa won a Caritas pilot after the buyer saw LinkedIn content Enablement helped create. The wider engagement also included outbound and GTM work.</p></div><CaseStudyCard cs={proof} /></div></section>}

  <FAQ eyebrow="Before you request" headline="What to expect." questions={faq} />

  <section class="section final-section"><div class="container final-inner"><span class="eyebrow">LinkedIn Analysis</span><h2>See the gap. Then decide <span class="italic-accent">what to do with it.</span></h2><p class="lead">Get a personal analysis of the LinkedIn content in your category, with a clear path from attention to pipeline.</p><a href="#request-analysis" class="btn btn-accent btn-lg">Find my content gap</a></div></section>

  <script>
    const form = document.querySelector<HTMLFormElement>("#competitor-request-form")!;
    const status = document.querySelector<HTMLElement>("#competitor-request-status")!;
    const progress = document.querySelector<HTMLElement>("#analysis-progress")!;
    const progressTitle = document.querySelector<HTMLElement>("#analysis-progress-title")!;
    const progressMessage = document.querySelector<HTMLElement>("#analysis-progress-message")!;
    const results = document.querySelector<HTMLElement>("#analysis-results")!;
    const startOver = document.querySelector<HTMLButtonElement>("#analysis-start-over")!;
    const wait = document.querySelector<HTMLElement>("#analysis-wait")!;
    const stay = document.querySelector<HTMLElement>("#analysis-stay")!;
    const elapsed = document.querySelector<HTMLElement>("#analysis-elapsed")!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const storageKey = "enablement-linkedin-analysis-job";
    let pollTimer: number | undefined;
    let clockTimer: number | undefined;
    let startedAt = Date.now();

    function addText(parent: HTMLElement, tag: string, value: string, className = "") {
      const element = document.createElement(tag);
      element.textContent = value;
      if (className) element.className = className;
      parent.append(element);
      return element;
    }

    function addSource(parent: HTMLElement, url: string, label = "View source ↗") {
      const link = document.createElement("a");
      link.href = url;
      link.textContent = label;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      parent.append(link);
    }

    const number = (value: number) => new Intl.NumberFormat("en").format(value || 0);
    function setClock(start: string | number) {
      startedAt = typeof start === "number" ? start : Date.parse(start) || Date.now();
      if (clockTimer) window.clearInterval(clockTimer);
      const tick = () => {
        const seconds = Math.max(0, Math.floor((Date.now() - startedAt) / 1000));
        elapsed.textContent = `${String(Math.floor(seconds / 60)).padStart(2, "0")}:${String(seconds % 60).padStart(2, "0")}`;
      };
      tick();
      clockTimer = window.setInterval(tick, 1000);
    }
    function stopClock() {
      if (clockTimer) window.clearInterval(clockTimer);
      wait.hidden = true;
      stay.hidden = true;
    }

    function founderCard(person: any, isOwn = false) {
      const card = document.createElement("article");
      card.className = isOwn ? "founder-card founder-own" : "founder-card";
      addText(card, "span", isOwn ? "YOUR PROFILE" : person.name.toUpperCase(), "card-eyebrow");
      addText(card, "h6", person.founderName);
      const metrics = document.createElement("div");
      metrics.className = "founder-metrics";
      for (const [value, label] of [
        [person.followers == null ? "Unavailable" : number(person.followers), "followers"],
        [`${person.countIsMinimum ? "≥" : ""}${number(person.posts90)}`, "posts / 90 days"],
        [number(person.averageEngagement), "avg. interactions"],
        [number(person.medianEngagement), "median interactions"],
      ]) {
        const metric = document.createElement("div");
        addText(metric, "strong", value);
        addText(metric, "span", label);
        metrics.append(metric);
      }
      card.append(metrics);
      if (!isOwn && person.highlight) {
        addText(card, "p", `Top sampled post: ${number(person.highlight.likes + person.highlight.comments + person.highlight.reposts)} interactions. ${person.highlight.text.slice(0, 135)}…`, "founder-highlight");
        addSource(card, person.highlight.url, "Read the post ↗");
      }
      addSource(card, person.founderUrl, "View profile ↗");
      return card;
    }

    function showReport(report: any) {
      results.replaceChildren();
      addText(results, "span", `90-DAY CONTENT SCAN / ${report.checkedAt}`, "report-eyebrow");
      addText(results, "h4", report.headline);
      addText(results, "p", report.summary, "report-summary");
      const pain = document.createElement("div");
      pain.className = "report-pain";
      addText(pain, "span", "THE PROBLEM", "card-eyebrow");
      addText(pain, "p", report.pain);
      results.append(pain);
      addText(results, "h5", "The founder comparison");
      addText(results, "p", report.categoryFinding);
      const founders = document.createElement("div");
      founders.className = "founder-grid";
      founders.append(founderCard(report.own, true));
      for (const person of report.competitors) founders.append(founderCard(person));
      results.append(founders);
      const featured = new Set(report.competitors.map((person: any) => person.domain));
      const others = (report.screenedCompetitors || []).filter((person: any) => !featured.has(person.domain));
      if (others.length) {
        const extra = document.createElement("p");
        extra.className = "screened-peers";
        addText(extra, "strong", "Also screened: ");
        for (const [index, person] of others.entries()) {
          if (index) extra.append(document.createTextNode(" · "));
          addSource(extra, person.url, person.name);
        }
        results.append(extra);
      }
      addText(results, "h5", "What they talk about");
      if (report.topics.length) {
        const topicList = document.createElement("div");
        topicList.className = "report-topics";
        for (const [index, item] of report.topics.entries()) {
          const card = document.createElement("article");
          addText(card, "span", `TOPIC 0${index + 1}`, "card-eyebrow");
          addText(card, "h6", item.title);
          addText(card, "p", `${number(item.postCount)} competitor posts · ${number(item.founderCount)} founders · ${number(item.averageEngagement)} average interactions · ${number(item.medianEngagement)} median`, "topic-metrics");
          addText(card, "p", item.finding);
          addSource(card, item.sourceUrl, "See example post ↗");
          topicList.append(card);
        }
        results.append(topicList);
      } else {
        addText(results, "p", "No sustained buyer topic appeared in the verified founder-post sample.");
      }
      const performance = document.createElement("div");
      performance.className = "report-performance";
      for (const [heading, finding] of [["What earns attention", report.whatWorks], ["What looks weaker", report.whatIsWeaker]]) {
        if (!finding) continue;
        const card = document.createElement("article");
        addText(card, "h6", heading);
        addText(card, "p", finding);
        performance.append(card);
      }
      results.append(performance);
      addText(results, "h5", "Where you could make a mark");
      const openingList = document.createElement("div");
      openingList.className = "analysis-list";
      for (const [index, item] of report.openings.entries()) {
        const card = document.createElement("article");
        addText(card, "span", `OPENING 0${index + 1}`, "card-eyebrow");
        addText(card, "h6", item.title);
        addText(card, "p", item.buyerProblem);
        addText(card, "p", item.whyItFits);
        addText(card, "p", `First post: ${item.firstMove}`, "first-move");
        openingList.append(card);
      }
      results.append(openingList);
      const next = document.createElement("div");
      next.className = "report-next";
      addText(next, "span", "GO DEEPER", "card-eyebrow");
      addText(next, "h5", "Turn the opening into content buyers remember.");
      addText(next, "p", "This is a quick automated scan of public posts. In a free audit, we'll examine your positioning, shape content that earns relevant attention, and build the follow-up that turns that attention into sales conversations.");
      const audit = document.createElement("a");
      audit.href = "https://revenue.enablement.ch/meetings/l-heiz/firstmeeting";
      audit.className = "btn btn-accent btn-md";
      audit.textContent = "Book my free LinkedIn audit";
      next.append(audit);
      results.append(next);
      if (report.limitations) addText(results, "p", report.limitations, "analysis-limitations");
      results.hidden = false;
    }

    async function poll(jobId: string) {
      try {
        const response = await fetch(`/api/linkedin-analysis-status?jobId=${encodeURIComponent(jobId)}`, { cache: "no-store" });
        const job = await response.json();
        if (!response.ok) throw new Error(job.error || "Could not check status");
        if (job.createdAt && startedAt > Date.parse(job.createdAt)) setClock(job.createdAt);
        if (job.status === "waiting_for_clay") {
          progressTitle.textContent = "Enriching your request";
          progressMessage.textContent = "We received your details. This page will update when the enrichment arrives from Clay.";
        } else if (job.status === "researching") {
          const stages: Record<string, [string, string]> = {
            understanding_company: ["Understanding your company", "We are reading your offer and identifying the services and buyers to compare."],
            discovering_competitors: ["Finding comparable businesses", "We are searching for companies with a similar offer and buyer."],
            screening_competitors: ["Checking the competitor set", "We are verifying each company's business model and positioning."],
            resolving_founders: ["Finding the founder voices", "We are verifying current founders and leaders at the comparable companies."],
            collecting_posts: ["Reading founder posts", "We are reviewing verified founders' posts from the last 90 days."],
            classifying_topics: ["Mapping the content topics", "We are grouping the posts and calculating which topics attract engagement."],
            writing_analysis: ["Building your analysis", "We are comparing topics, engagement, and defensible openings."],
          };
          const [title, message] = stages[job.stage] || ["Researching the content gap", "We are checking public sources and preparing the findings."];
          progressTitle.textContent = title;
          progressMessage.textContent = message;
        } else if (job.status === "complete") {
          stopClock();
          progressTitle.textContent = `Your analysis for ${job.report.companyName}`;
          progressMessage.textContent = "The analysis is ready.";
          progress.classList.add("has-results");
          showReport(job.report);
          startOver.hidden = false;
          return;
        } else if (job.status === "failed") {
          stopClock();
          progressTitle.textContent = "We could not finish the analysis";
          progressMessage.textContent = job.message;
          startOver.hidden = false;
          return;
        }
      } catch (error) {
        if (error instanceof Error && error.message.includes("expired or not found")) {
          stopClock();
          progressTitle.textContent = "This analysis has expired";
          progressMessage.textContent = "Start a new analysis to see current findings.";
          startOver.hidden = false;
          return;
        }
        progressMessage.textContent = error instanceof Error ? `${error.message}. Retrying shortly.` : "Status is temporarily unavailable. Retrying shortly.";
      }
      pollTimer = window.setTimeout(() => poll(jobId), 5000);
    }

    function showProgress(jobId: string) {
      if (pollTimer) window.clearTimeout(pollTimer);
      wait.hidden = false;
      stay.hidden = false;
      setClock(Date.now());
      form.hidden = true;
      progress.hidden = false;
      progress.focus();
      poll(jobId);
    }

    startOver.addEventListener("click", () => {
      if (pollTimer) window.clearTimeout(pollTimer);
      stopClock();
      localStorage.removeItem(storageKey);
      const url = new URL(location.href);
      url.searchParams.delete("jobId");
      history.replaceState(null, "", url);
      results.hidden = true;
      results.replaceChildren();
      startOver.hidden = true;
      progress.classList.remove("has-results");
      progress.hidden = true;
      form.hidden = false;
      form.reset();
      submit.disabled = false;
      status.textContent = "";
    });

    const sharedJob = new URLSearchParams(location.search).get("jobId");
    const existingJob = sharedJob && /^[a-f0-9]{40}$/.test(sharedJob) ? sharedJob : localStorage.getItem(storageKey);
    if (sharedJob && existingJob === sharedJob) localStorage.setItem(storageKey, sharedJob);
    if (existingJob && /^[a-f0-9]{40}$/.test(existingJob)) showProgress(existingJob);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = Object.fromEntries(new FormData(form));
      const params = new URLSearchParams(location.search);
      const payload = { ...data, pageUrl: location.href, referrer: document.referrer,
        utmSource: params.get("utm_source") || "", utmMedium: params.get("utm_medium") || "", utmCampaign: params.get("utm_campaign") || "",
        utmTerm: params.get("utm_term") || "", utmContent: params.get("utm_content") || "" };
      status.textContent = "Sending your request...";
      submit.disabled = true;
      try {
        const response = await fetch("/api/competitor-content-request", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(payload) });
        const body = await response.json();
        if (!response.ok || !body.ok || !/^[a-f0-9]{40}$/.test(body.jobId)) throw new Error(body.error || "Could not send your request.");
        localStorage.setItem(storageKey, body.jobId);
        showProgress(body.jobId);
        (window as Window & { syft?: { track?: (event: string, properties: Record<string, string>) => void } }).syft?.track?.("competitor_content_pull_requested", { company_domain: String(data.companyDomain || "") });
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Could not send your request. Please try again.";
        submit.disabled = false;
      }
    });
  </script>

  <style is:global>
    .pull-hero { padding: 105px 0 95px; border-bottom: 1px solid var(--color-border); }
    .hero-grid { display: grid; grid-template-columns: 1.07fr .93fr; gap: clamp(40px, 6vw, 90px); align-items: center; }
    .hero-copy h1 { max-width: 750px; line-height: 1.05; margin: 18px 0 21px; }
    .hero-copy .lead { max-width: 630px; margin: 0 0 30px; }
    .hero-note { display: block; margin-top: 16px; color: var(--color-muted); font: 12px var(--font-mono); }
    .report-preview { background: #171b22; border: 1px solid var(--color-border-strong); border-radius: 12px; box-shadow: 0 22px 80px rgba(0,0,0,.24); overflow: hidden; }
    .preview-top { display: flex; justify-content: space-between; padding: 19px 24px; border-bottom: 1px solid var(--color-border); color: var(--color-muted); font: 11px var(--font-mono); letter-spacing: .08em; }
    .preview-top span:last-child { color: var(--color-accent); font-size: 18px; }
    .preview-main { padding: 30px 26px 32px; border-bottom: 1px solid var(--color-border); }
    .preview-kicker { display: block; color: var(--color-accent); font: 11px var(--font-mono); margin-bottom: 18px; }
    .preview-main strong { display: block; font-size: clamp(22px, 2.4vw, 32px); line-height: 1.18; color: var(--color-heading); font-weight: 600; }
    .preview-row { display: flex; gap: 20px; padding: 19px 26px; border-bottom: 1px solid var(--color-border); }
    .preview-row:last-child { border: 0; }
    .preview-row > span { color: var(--color-accent); font: 11px var(--font-mono); padding-top: 4px; }
    .preview-row strong, .preview-row small { display: block; }
    .preview-row strong { color: var(--color-heading); font-size: 16px; }
    .preview-row small { color: var(--color-muted); font-size: 13px; margin-top: 2px; }
    .request-section, .finding-section, .audit-section, .proof-section, .final-section { border-bottom: 1px solid var(--color-border); }
    .request-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 510px); gap: clamp(40px, 8vw, 100px); align-items: start; }
    .request-intro h2, .finding-grid h2, .section-heading h2, .proof-grid h2, .final-inner h2 { margin: 12px 0 18px; }
    .request-intro p { max-width: 560px; }
    .request-steps { margin-top: 38px; border-top: 1px solid var(--color-border); }
    .request-steps div { display: grid; grid-template-columns: 100px 1fr; gap: 14px; padding: 19px 0; border-bottom: 1px solid var(--color-border); }
    .request-steps span, .audit-grid article > span { color: var(--color-accent); font: 11px var(--font-mono); text-transform: uppercase; letter-spacing: .04em; }
    .request-steps strong { color: var(--color-heading); font-weight: 600; }
    .request-form, .request-success { padding: clamp(24px, 4vw, 40px); background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--radius-lg); }
    .request-form h3, .request-success h3 { margin: 9px 0 25px; font-size: 28px; }
    .request-form label { display: block; color: var(--color-heading); font-size: 14px; margin-bottom: 17px; }
    .request-form input { display: block; width: 100%; min-height: 48px; margin-top: 7px; padding: 11px 13px; color: var(--color-heading); background: var(--color-bg); border: 1px solid var(--color-border-strong); border-radius: 6px; font: inherit; }
    .request-form input:focus { outline: 2px solid var(--color-accent); outline-offset: 1px; }
    .request-form input::placeholder { color: var(--color-muted); }
    .request-form button { width: 100%; justify-content: center; }
    .request-form button:disabled { opacity: .7; cursor: wait; }
    .form-note, .form-status { font-size: 13px; line-height: 1.5; color: var(--color-muted); margin: 12px 0 0; }
    .form-status:not(:empty) { color: var(--color-heading); }
    .honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; left: -9999px; }
    .request-success { grid-column: 2; }
    .request-success p { margin: 0 0 16px; }
    .request-success .btn { margin-top: 8px; }
    .request-success.has-results { grid-column: 1 / -1; }
    .analysis-wait { display: flex; align-items: center; gap: 16px; padding: 17px 20px; margin: 15px 0; color: var(--color-heading); font: 12px var(--font-mono); border: 1px solid var(--color-border-strong); border-radius: var(--radius-md); background: var(--color-bg); }
    .analysis-wait[hidden], .analysis-stay[hidden] { display: none; }
    .analysis-wait strong { display: inline-block; margin-left: 8px; min-width: 44px; color: var(--color-accent); font-weight: 500; }
