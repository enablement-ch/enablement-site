---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MarqueeLogoWall from "../../components/MarqueeLogoWall.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import StatStrip from "../../components/StatStrip.astro";
import FAQ from "../../components/FAQ.astro";
import { getCollection } from "astro:content";

const proofOrder = [
  "blueprint",
  "bound",
  "condenzero",
  "ekipa",
  "lipdub",
  "skillfit",
];

const proofStudies = (await getCollection("caseStudies"))
  .filter((study) => study.data.live && proofOrder.includes(study.id))
  .sort((a, b) => proofOrder.indexOf(a.id) - proofOrder.indexOf(b.id));

const meetingUrl = "https://revenue.enablement.ch/meetings/l-heiz/firstmeeting";

const auditQuestions = [
  {
    q: "What happens during the session?",
    a: "Lanny maps your go-to-market funnel from first activity to closed revenue. Together, you work through the numbers behind your inbound, outbound, partnerships, lead management, sales process, and reporting. The goal is to identify where opportunities and revenue are actually being lost, not to give you another list of generic best practices.",
  },
  {
    q: "How long does it take, and what does it cost?",
    a: "The session is completely free. Plan for 30 minutes. We leave up to 45 minutes when the system needs a deeper look.",
  },
  {
    q: "What should I prepare?",
    a: "Bring the best numbers you have: current marketing activities, inbound, outbound and partnership performance, top-line revenue, average contract value, lead volume, reply rates, meetings booked, qualified meetings, opportunities, closed-won deals, and your typical sales cycle. Imperfect numbers are fine. Missing numbers are often part of the diagnosis.",
  },
  {
    q: "Do I need to share my CRM?",
    a: "No. We can work with the numbers you provide. If you want to open your CRM or dashboards during the session, that usually makes the diagnosis faster and more precise.",
  },
  {
    q: "What do I receive afterward?",
    a: "You receive a written diagnosis within 24 hours. It captures the bottlenecks we found, the evidence behind them, the order in which they should be addressed, and what your team can fix internally.",
  },
  {
    q: "Who is the Allbound Audit for?",
    a: "It is designed for B2B SaaS and tech-enabled service companies with product-market fit, usually between $1M and $15M in annual revenue. The strongest fit is a company that has no repeatable outbound system or has already invested in outbound, tools, or headcount without getting reliable pipeline from it. It is not designed for pre-product-market-fit companies or businesses below $500K in annual revenue.",
  },
  {
    q: "What if Enablement is not the right solution?",
    a: "You still receive the diagnosis. Lanny will explain what should be fixed internally and where your team should focus next. If the problem is one we can solve, he will also explain what working together could look like.",
  },
];

const bottlenecks = [
  {
    number: "01",
    area: "GTM motion",
    severity: "Critical",
    pain: "Your market has fewer than 10,000 accounts. Your team is burning through it at a 0.2% positive reply rate.",
    impact: "Two or three BDRs and one or two AEs spend up to 60% of their time researching and contacting buyers who have never heard of you. At that reply rate, every generic touch uses up a scarce chance to earn attention.",
    outcome: "Protect a finite market with a motion built around fit and buyer readiness.",
  },
  {
    number: "02",
    area: "Customer intelligence",
    severity: "Medium",
    pain: "The founder defines one ICP. Marketing targets another. Sales only accepts a third.",
    impact: "The official ICP still comes from an agency workshop held two years ago. Current evidence is scattered across calls, CRM records, documents, Slack, and individual reps' heads. Marketing generates leads that sales rejects.",
    outcome: "Shared buyer criteria brought one client's list accuracy to 95% to 97% and raised MQL-to-SQL conversion by 30%.",
  },
  {
    number: "03",
    area: "Tool architecture",
    severity: "High",
    pain: "Clay, Apollo, and HubSpot. Your reps are still uploading CSV files.",
    impact: "The team pays $500 to $800 per month for Clay and uses it as an email finder. Reps move CSV files between tools and manually complete CRM fields. At Emporix, processing one lead took roughly three minutes and 50 clicks.",
    outcome: "After connecting the stack, Emporix processed a lead in under four seconds and increased pipeline output 3.2 times.",
  },
  {
    number: "04",
    area: "Targeting and timing",
    severity: "High",
    pain: "Every Monday, 50 more accounts are contacted. Nobody knows whether any are ready to buy.",
    impact: "Reps work alphabetically through static lists and treat job openings or funding announcements as intent. But those signals are public, late, and often unrelated to the problem you solve. Meanwhile, accounts visiting your website, consuming content, or engaging with your category pass through their buying window unnoticed.",
    outcome: "Rank accounts by fit, signal strength, and readiness to buy.",
  },
  {
    number: "05",
    area: "Messaging and activation",
    severity: "High",
    pain: "You saw a job opening. Guessed the problem. Asked a stranger for a meeting.",
    impact: "The observation may be correct. Everything after it is an assumption. The problem may not exist, the persona may be wrong, and the buyer has no reason to trust you. Yet every segment receives the same message and hard meeting request.",
    outcome: "Relevance-based messaging took Warmly's response rate from 0.2% to 7.7%.",
  },
  {
    number: "06",
    area: "Data and qualification",
    severity: "High",
    pain: "Your CRM has 10,000 contacts. By next quarter, 1,000 to 2,000 could already be out of date.",
    impact: "People change jobs, companies, roles, and email addresses. Meanwhile, duplicates and incomplete records keep entering the CRM. Automations fail, reporting becomes unreliable, and reps repair fields manually. Eventually, a customer, partner, or active opportunity receives cold outreach because sales and automation are working from different lists.",
    outcome: "Keep records current so routing works and active buyers never receive cold outreach.",
  },
  {
    number: "07",
    area: "Lead qualification and routing",
    severity: "Critical",
    pain: "More than 300 positive replies in three months. Only 10% to 15% turned into meetings.",
    impact: "Blueprint thought outbound was failing. In reality, interested leads were sitting across disconnected tools without consistent follow-up, context, or attribution.",
    outcome: "Fixed handoffs lifted positive-reply-to-meeting conversion to 50%. The motion later contributed over $10 million in closed revenue.",
  },
  {
    number: "08",
    area: "Sales process and automation",
    severity: "High",
    pain: "The CRM says the quarter is covered. Nobody can say which deals will actually close.",
    impact: "Calls end without a committed next step. CRM fields are updated from memory. Deal stages change because someone selected a dropdown, not because the buyer made a commitment. The forecast looks healthy until the revenue gap becomes impossible to recover. Meanwhile, expensive salespeople spend hours preparing meetings, writing summaries, updating records, and setting reminders.",
    outcome: "Automate administration and follow-up while tying deal stages to buyer commitments.",
  },
  {
    number: "09",
    area: "Revenue reporting",
    severity: "High",
    pain: "One GTM motion was outperforming another by 3.7 times. The dashboard made them look the same.",
    impact: "The client saw aggregate contacts, replies, meetings, and deals. Without revenue attribution, leadership could have hired into the weaker channel, cut the stronger one, or scaled a funnel that was still leaking revenue.",
    outcome: "First-touch-to-revenue attribution showed which motion produced 3.7 times more.",
  },
  {
    number: "10",
    area: "Feedback and experimentation",
    severity: "Medium",
    pain: "The campaign ends. Someone says, \"I do not like the copy.\" On Monday, four things change at once.",
    impact: "The team changes the audience, message, offer, and channel without a hypothesis or enough volume to learn anything. Wins are celebrated, losses are closed, and neither is analyzed. The next experiment comes from gut feeling or whatever is popular on LinkedIn. Promising ideas are killed early while weak ones survive because one reply felt encouraging.",
    outcome: "Test one hypothesis at a time and feed replies, calls, wins, and losses into the next decision.",
  },
];

const comparison = [
  ["Teams choose channels from habit and disagree on the buyer", "One evidence-based motion aligns the team around how buyers buy"],
  ["Disconnected tools and dirty data create manual work", "A lean, connected stack keeps data clean and work automated"],
  ["Static lists and generic messages treat every buyer the same", "Fit, intent, and awareness determine the next best action"],
  ["Qualified interest gets lost between marketing, sales, and the CRM", "Every qualified lead has context, an owner, and a path to revenue"],
  ["Reports show activity while decisions rely on gut feeling", "Revenue attribution and feedback improve every next decision"],
];
---

<BaseLayout
  title="Allbound Audit | Find the Leaks in Your Go-to-Market System"
  description="Find the bottlenecks across your go-to-market system that prevent activity from turning into revenue. Book an Allbound Audit with Enablement.ch."
>
  <header class="audit-hero">
    <div class="container audit-hero-inner">
      <span class="eyebrow"><span class="num">↳</span> Allbound Audit</span>
      <h1 class="display">
        Your go-to-market system does not need more activity.<br />
        It needs <span class="italic-accent">fewer leaks.</span>
      </h1>
      <p class="lead audit-hero-lead">
        Fix the bottlenecks in how you target, engage, and convert buyers before you add more tools, campaigns, or headcount.
      </p>
      <div class="audit-hero-actions">
        <a href={meetingUrl} class="btn btn-accent btn-md">Yes, I want to fix my GTM system</a>
        <span class="mono">10 failure points · One connected view</span>
      </div>

      <div class="vsl-video">
        <iframe
          src="https://www.youtube-nocookie.com/embed/HfBbpHC_UaY"
          title="Why more activity will not fix a broken go-to-market system"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </header>

  <MarqueeLogoWall label="Trusted by 125+ B2B companies" />

  <StatStrip
    stats={[
      { number: "$10M+", label: "Closed revenue from one client motion" },
      { number: "2×", label: "7-figure pipeline in 90 days" },
      { number: "$2.4M", label: "Pipeline from one conference" },
    ]}
  />

  <section class="section audit-intro" id="diagnostic">
    <div class="container narrow-stack">
      <span class="eyebrow">The real problem</span>
      <h2>The <span class="revenue-emphasis">revenue lost</span> in your go-to-market system rarely comes from one obvious place.</h2>
      <div class="system-graphic-placeholder" role="img" aria-label="Placeholder for a future go-to-market system flowchart showing handoffs and warning points">
        <span class="graphic-placeholder-label">GTM system flowchart · graphic coming soon</span>
        <div class="graphic-placeholder-flow" aria-hidden="true">
          <span>Target</span><b>→</b><span>Engage</span><b>⚠</b><span>Qualify</span><b>→</b><span>Convert</span><b>⚠</b><span>Measure</span>
        </div>
        <span class="graphic-placeholder-note">Planned: system architecture with warning markers at revenue leaks</span>
      </div>
      <p class="diagnosis-line">
        If several of the points below feel familiar, doing more is not the answer. You need to fix your GTM system.
      </p>
    </div>
  </section>

  <section class="section bottleneck-section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">The diagnostic</span>
        <h2>The 10 places your GTM system quietly <span class="italic-accent">leaks revenue.</span></h2>
        <p class="lead">How many of these are happening inside your GTM system right now?</p>
      </div>

      <ol class="bottleneck-list">
        {bottlenecks.map((item) => (
          <li class="bottleneck-item">
            <div class="bottleneck-meta">
              <span class="bottleneck-number">{item.number}</span>
              <span class="bottleneck-area">{item.area}</span>
            </div>
            <div class="bottleneck-copy">
              <h3>{item.pain}</h3>
              <p>{item.impact}</p>
            </div>
            <div class="bottleneck-side">
              <span class:list={["severity-tag", `severity-${item.severity.toLowerCase()}`]}>{item.severity}</span>
              <div class="bottleneck-outcome">
                <span class="outcome-label">Impact when fixed</span>
                <p>{item.outcome}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <div class="pain-summary">
        <span class="eyebrow">What this adds up to</span>
        <p>
          If your GTM system is poorly designed, the only things you scale are manual work, disconnected data, and cost.
        </p>
      </div>
    </div>
  </section>

  <section class="section worlds-section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Two operating models</span>
        <h2>From disconnected activities to one <span class="italic-accent">Allbound System.</span></h2>
        <p class="lead">The difference is not another tool. It is what happens between the tools you already have.</p>
      </div>

      <div class="worlds-grid">
        <div class="world-column world-old">
          <div class="world-heading">
            <span class="world-kicker">The old world</span>
            <h3>Activity without a system</h3>
          </div>
          <ul>
            {comparison.map(([old]) => <li><span class="world-mark">×</span><span>{old}</span></li>)}
          </ul>
          <p class="world-verdict">More activity. More tools. No clear path to revenue.</p>
        </div>

        <div class="world-column world-new">
          <div class="world-heading">
            <span class="world-kicker">The new world</span>
            <h3>One connected Allbound System</h3>
          </div>
          <ul>
            {comparison.map(([, current]) => <li><span class="world-mark">✓</span><span>{current}</span></li>)}
          </ul>
          <p class="world-verdict">Every stage connects. Every outcome improves the next decision.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section audit-process-section" id="audit">
    <div class="container">
      <div class="audit-process-grid">
        <div class="audit-process-intro">
          <span class="eyebrow">The Allbound Audit</span>
          <h2>Stop guessing what to fix first.</h2>
          <p class="lead">
            We review your go-to-market system end to end, identify where opportunities are getting lost, and separate the urgent bottlenecks from the expensive distractions.
          </p>
          <a href={meetingUrl} class="btn btn-accent btn-md">Yes, I want to fix my GTM system</a>
        </div>

        <div class="audit-steps">
          <article class="audit-step">
            <span class="audit-step-number">01</span>
            <div>
              <h3>Map your go-to-market system</h3>
              <p>We map your motion, customer intelligence, tool stack, and the full path from targeting through messaging, routing, sales, CRM, and reporting.</p>
            </div>
          </article>
          <article class="audit-step">
            <span class="audit-step-number">02</span>
            <div>
              <h3>Find the real bottlenecks</h3>
              <p>We identify the handoffs causing lost context, wasted seller time, missed opportunities, or unreliable reporting.</p>
            </div>
          </article>
          <article class="audit-step">
            <span class="audit-step-number">03</span>
            <div>
              <h3>Prioritize what changes next</h3>
              <p>You leave knowing what to fix first, what can wait, and where another tool or campaign would only add complexity.</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="section proof-section" id="customer-results">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Customer results</span>
        <h2>The system has to produce more than <span class="italic-accent">activity.</span></h2>
        <p class="lead">
          Different markets. Different companies. The same shift from disconnected activity to a go-to-market system the team can operate and measure.
        </p>
      </div>

      <div class="case-grid">
        {proofStudies.map((study) => <CaseStudyCard cs={study} />)}
      </div>

      <div class="proof-footer">
        <a href="/customer-results" class="btn btn-secondary btn-md">See all customer results</a>
      </div>
    </div>
  </section>

  <section class="section authority-section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">Who is behind the audit</span>
        <h2>Commercial diagnosis in the call. Technical depth behind it.</h2>
        <p class="lead">
          Lanny maps the problem and writes the diagnosis. Gilbert leads the system architecture and fulfilment when the solution requires us.
        </p>
      </div>

      <div class="authority-grid">
        <article class="authority-card">
          <img src="/team/lanny.png" alt="Lanny Heiz" class="authority-photo" />
          <div>
            <span class="authority-role">Co-Founder and GTM Advisor</span>
            <h3>Lanny Heiz</h3>
            <p>Lanny runs the session. He maps your current marketing and sales activities against the hard numbers, finds where the funnel loses revenue, and turns the conversation into a written diagnosis and priority order.</p>
            <a href="https://www.linkedin.com/in/lanny-heiz/" target="_blank" rel="noopener">View Lanny on LinkedIn</a>
          </div>
        </article>

        <article class="authority-card">
          <img src="/team/gilbert.png" alt="Gilbert Kralinger" class="authority-photo" />
          <div>
            <span class="authority-role">Founder and GTM Architect</span>
            <h3>Gilbert Kralinger</h3>
            <p>Gilbert leads fulfilment and the technical architecture behind the recommendations. Enablement has implemented 52 Clay accounts and more than 85 HubSpot instances across targeting, automation, routing, CRM, and reporting.</p>
            <a href="https://www.linkedin.com/in/gilbert-kralinger/" target="_blank" rel="noopener">View Gilbert on LinkedIn</a>
          </div>
        </article>
      </div>

      <a class="clay-proof" href="https://www.clay.com/en/experts/partner/enablement" target="_blank" rel="noopener">
        <span>Clay Solutions Partner</span>
        <span>Signals · AI outbound · enrichment · account scoring</span>
      </a>
    </div>
  </section>

  <FAQ
    eyebrow="Before you book"
    headline="What to expect from the Allbound Audit."
    questions={auditQuestions}
  />

  <section class="section outcome-section" id="book-audit">
    <div class="container">
      <div class="outcome-card">
        <div class="outcome-copy">
          <span class="eyebrow">Your outcome</span>
          <h2>A clear view of what is broken and what to do next.</h2>
          <p class="lead">
            Not a generic tool recommendation. Not another list of best practices. A practical diagnosis of your go-to-market system and the build order that makes the entire system work.
          </p>
          <a href={meetingUrl} class="btn btn-accent btn-lg">Yes, I want to fix my GTM system</a>
          <span class="mono">Free · 30 minutes · Written diagnosis within 24 hours</span>
        </div>

        <div class="outcome-list">
          <div class="outcome-item">
            <span class="outcome-number">01</span>
            <div><strong>Your bottleneck map</strong><span>Where leads, context, and opportunities currently fall out.</span></div>
          </div>
          <div class="outcome-item">
            <span class="outcome-number">02</span>
            <div><strong>Your priority order</strong><span>Which changes unlock the largest improvement first.</span></div>
          </div>
          <div class="outcome-item">
            <span class="outcome-number">03</span>
            <div><strong>Your next-step recommendation</strong><span>What to repair, rebuild, automate, or leave alone.</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    :global(:root) {
      --audit-pink: #FFF2F5;
      --audit-pink-strong: #FCE8ED;
      --audit-red-soft: #FBE6E9;
      --audit-green-soft: #E5F4E9;
      --audit-amber-soft: #FFF2D8;
      --audit-amber-text: #8A5600;
    }
    .audit-hero .eyebrow,
    .audit-intro .eyebrow,
    .bottleneck-section .eyebrow,
    .worlds-section .eyebrow,
    .audit-process-section .eyebrow,
    .proof-section .eyebrow,
    .authority-section .eyebrow,
    .outcome-section .eyebrow { color: var(--color-accent); }
    section.section { padding-block: 72px; }
    .revenue-emphasis { color: var(--color-accent); }

    .audit-hero {
      position: relative;
      padding: 72px 0 64px;
      border-bottom: 1px solid var(--color-border);
      overflow: hidden;
    }
    .audit-hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(160deg, var(--audit-pink) 0%, var(--color-canvas) 62%);
      pointer-events: none;
    }
    .audit-hero-inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .audit-hero h1 { max-width: 990px; margin-top: var(--space-4); }
    .audit-hero-lead { max-width: 700px; margin-top: var(--space-4); }
    .audit-hero-actions {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-5);
      margin-top: var(--space-6);
    }
    .vsl-video {
      position: relative;
      width: min(100%, 960px);
      aspect-ratio: 16 / 9;
      margin-top: var(--space-7);
      overflow: hidden;
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-lg);
      background: var(--color-heading);
      box-shadow: var(--shadow-lg);
      color: var(--color-inverse);
    }
    .vsl-video iframe {
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .narrow-stack { max-width: 820px; }
    .narrow-stack h2 { margin-top: var(--space-3); }
    .audit-intro { background: var(--color-surface); }
    .system-graphic-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-5);
      min-height: 290px;
      margin-top: var(--space-6);
      padding: var(--space-6);
      border: 1px dashed var(--color-accent);
      border-radius: var(--radius-md);
      background: var(--audit-pink);
      text-align: center;
    }
    .graphic-placeholder-label,
    .graphic-placeholder-note { font-family: var(--font-mono); font-size: var(--font-size-caption); color: var(--color-accent); }
    .graphic-placeholder-label { font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
    .graphic-placeholder-note { color: var(--color-muted); }
    .graphic-placeholder-flow { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-2); }
    .graphic-placeholder-flow span { padding: var(--space-2) var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); color: var(--color-heading); font-weight: 600; }
    .graphic-placeholder-flow b { color: var(--color-warning); font-size: 1.3rem; }
    .diagnosis-line {
      margin-top: var(--space-5);
      padding-left: var(--space-5);
      border-left: 3px solid var(--color-accent);
      color: var(--color-heading);
      font-size: var(--font-size-lead);
      font-weight: 600;
    }

    .section-heading { max-width: 760px; margin-bottom: var(--space-6); }
    .section-heading h2 { margin-top: var(--space-3); }
    .section-heading .lead { margin-top: var(--space-3); }
    .bottleneck-section { background: var(--color-canvas); }
    .bottleneck-list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--color-border-strong);
    }
    .bottleneck-item {
      display: grid;
      grid-template-columns: 128px minmax(0, 1fr) minmax(220px, .62fr);
      gap: var(--space-5);
      align-items: start;
      padding: var(--space-6) 0;
      border-bottom: 1px solid var(--color-border);
    }
    .bottleneck-meta { display: flex; flex-direction: column; gap: var(--space-2); }
    .bottleneck-number {
      font-family: var(--font-mono);
      font-size: var(--font-size-caption);
      color: var(--color-accent);
    }
    .bottleneck-area {
      font-family: var(--font-mono);
      font-size: var(--font-size-eyebrow);
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    .bottleneck-copy h3 { max-width: 780px; font-size: clamp(1.35rem, 2.1vw, 1.8rem); font-weight: 700; }
    .bottleneck-copy p { margin-top: var(--space-3); color: var(--color-body); font-size: .95rem; line-height: 1.55; }
    .bottleneck-side { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
    .severity-tag { display: inline-flex; padding: 5px 11px; border-radius: var(--radius-pill); font: 700 .7rem var(--font-mono); text-transform: uppercase; letter-spacing: .04em; }
    .severity-critical { color: var(--color-critical); background: var(--audit-red-soft); }
    .severity-high { color: var(--color-accent-hover); background: var(--audit-pink-strong); }
    .severity-medium { color: var(--audit-amber-text); background: var(--audit-amber-soft); }
