---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const studies = await getCollection("caseStudies");
  return studies
    .filter((cs) => cs.data.live)
    .map((cs) => ({ params: { slug: cs.id }, props: { cs } }));
}

const { cs } = Astro.props;
const { Content } = await render(cs);
const hasVideo = !!cs.data.videoTestimonial;
const title = cs.data.headline ?? `How ${cs.data.company} got ${cs.data.result}`;
const lead = cs.data.subhead ?? cs.data.outcome;

const facts: Array<{ label: string; value: string }> = [
  cs.data.industry && { label: "Industry", value: cs.data.industry },
  cs.data.teamSize && { label: "Team size", value: String(cs.data.teamSize) },
  cs.data.geography && { label: "Geography", value: cs.data.geography },
  cs.data.engagementLength && {
    label: "Engagement",
    value: cs.data.engagementLength,
  },
].filter(Boolean) as Array<{ label: string; value: string }>;

const initials = cs.data.person?.name
  ? cs.data.person.name
      .split(" ")
      .map((s) => s[0])
      .slice(0, 2)
      .join("")
  : "";

const hasStructuredBody =
  !!cs.data.challenge ||
  !!cs.data.solution ||
  !!cs.data.solutionSteps ||
  !!cs.data.results ||
  !!cs.data.outcomeSection;
const pipelineTitleMatch = title.match(/^(.* generated .+?)( in pipeline.*)$/);
const generatedTitleParts = title.split(" generated ");

const compactParagraphs = (...items: Array<string | undefined>) =>
  items.filter(Boolean) as string[];

const challengeParagraphs =
  cs.data.challenge?.paragraphs ??
  compactParagraphs(cs.data.challenge?.intro, cs.data.challenge?.keyLine);

const solutionParagraphs =
  cs.data.solution?.paragraphs ??
  cs.data.solutionSteps?.map((step) => `${step.title}: ${step.body}`) ??
  [];

const resultParagraphs =
  cs.data.results?.paragraphs ??
  compactParagraphs(cs.data.results?.intro, cs.data.results?.narrative);

const outcomeParagraphs =
  cs.data.outcomeSection?.paragraphs ?? compactParagraphs(cs.data.finalLesson);
---

<BaseLayout title={`${title} - Enablement.ch`} description={cs.data.outcome}>
  <header class="hero case-detail-hero" data-variant={hasVideo ? "video" : "text"}>
    <div class="container">
      <div class="case-detail-hero-copy">
          <h1 class="case-detail-title">
            {
              pipelineTitleMatch ? (
                <>
                  <span>{pipelineTitleMatch[1]}</span>
                  <span>{pipelineTitleMatch[2].trim()}</span>
                </>
              ) : generatedTitleParts.length === 2 ? (
                <>
                  <span>{generatedTitleParts[0]} generated</span>
                  <span>{generatedTitleParts[1]}</span>
                </>
              ) : (
                title
              )
            }
          </h1>
      </div>
    </div>

    <div class="container">
      <div class="case-hero-lower">
        <div class="case-detail-video">
          <div class="case-detail-video-frame">
            {
              hasVideo ? (
                <iframe
                  class="case-detail-video-embed"
                  src={cs.data.videoTestimonial}
                  title={`Testimonial from ${cs.data.person?.name ?? cs.data.company}`}
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
                  referrerpolicy="strict-origin-when-cross-origin"
                  allowfullscreen
                />
              ) : (
                <div class="case-detail-video-placeholder">
                  <span class="play-btn">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"></path>
                    </svg>
                  </span>
                </div>
              )
            }
          </div>
        </div>

        <div class="case-proof-band">
          <div class="case-proof-metrics" data-count={cs.data.metrics.length}>
            {
              cs.data.metrics.map((m) => (
                <div class="case-proof-metric">
                  <div class="case-proof-num" set:html={m.value} />
                  <div class="case-proof-label">{m.label}</div>
                </div>
              ))
            }
          </div>

          {
            cs.data.featuredQuote && (
              <div class="case-proof-testimonial">
                <div class="case-proof-person-photo">
                  {cs.data.person?.photo ? (
                    <img src={cs.data.person.photo} alt={cs.data.person.name} />
                  ) : (
                    initials || "DS"
                  )}
                </div>
                <blockquote class="case-proof-quote">
                  <p>"{cs.data.featuredQuote.text}"</p>
                  <footer>
                    <span class="case-proof-byline">
                      <strong>{cs.data.featuredQuote.attribution}</strong>
                      {cs.data.featuredQuote.detail && (
                        <span class="case-proof-role">{cs.data.featuredQuote.detail}</span>
                      )}
                    </span>
                  </footer>
                </blockquote>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </header>

  <section class="section case-detail-story-section">
    <div class="container">
      {
        hasStructuredBody ? (
          <article class="case-detail-story">
            {cs.data.challenge && (
              <section class="case-story-block">
                <span class="eyebrow">01 / Challenge</span>
                <h2>{cs.data.challenge.title ?? cs.data.challenge.keyLine}</h2>
                <div class="case-story-copy">
                  {challengeParagraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
                {cs.data.challenge.quote && (
                  <blockquote class="case-inline-quote">
                    <p>"{cs.data.challenge.quote.text}"</p>
                    <footer>
                      <strong>{cs.data.challenge.quote.attribution ?? cs.data.person?.name}</strong>
                      {cs.data.challenge.quote.detail && (
                        <span>{cs.data.challenge.quote.detail}</span>
                      )}
                    </footer>
                  </blockquote>
                )}
              </section>
            )}

            {(cs.data.solution || cs.data.solutionSteps) && (
              <section class="case-story-block">
                <span class="eyebrow">02 / Solution</span>
                <h2>{cs.data.solution?.title ?? "We built the conference pipeline system."}</h2>
                <div class="case-story-copy">
                  {solutionParagraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </section>
            )}

            {cs.data.results && (
              <section class="case-story-block case-results-block">
                <span class="eyebrow">03 / Results</span>
                <h2>{cs.data.results.title ?? cs.data.result}</h2>
                <div class="case-story-copy">
                  {resultParagraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
                {cs.data.summaryMetrics && (
                  <div class="case-summary-metrics" data-count={cs.data.summaryMetrics.length}>
                    {cs.data.summaryMetrics.map((metric) => (
                      <div class="case-summary-metric">
                        <strong>{metric.value}</strong>
                        <span>{metric.label}</span>
                        {metric.description && <p>{metric.description}</p>}
                      </div>
                    ))}
                  </div>
                )}
              </section>
            )}

            {(cs.data.outcomeSection || cs.data.finalLesson) && (
              <section class="case-story-block">
                <span class="eyebrow">04 / Outcome</span>
                <h2>{cs.data.outcomeSection?.title ?? "The outcome is repeatable."}</h2>
                <div class="case-story-copy">
                  {outcomeParagraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </section>
            )}

          </article>
        ) : (
          <article class="prose case-narrative">
            <Content />
          </article>
        )
      }
    </div>
  </section>

  {
    facts.length > 0 && (
      <section class="section case-meta-section">
        <div class="container">
          <div class="divider-grid cols-4 case-meta-grid">
            {facts.map((f) => (
              <div class="dg-cell stack-3">
                <span class="eyebrow">{f.label}</span>
                <h5>{f.value}</h5>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FinalCTA
    headline="Want to build"
    accent="a similar system?"
    lead="Book a 30-min GTM session. We'll map your current GTM motion, find the highest-leverage system to build first, and tell you whether we're a fit."
    submitLabel={cs.data.cta?.label ?? "Book a GTM session"}
  />
</BaseLayout>

<style>
  .case-narrative {
    max-width: var(--container-prose);
    margin: 0 auto;
    font-size: var(--font-size-lead);
    line-height: 1.7;
  }
  .case-narrative :global(h2) {
    font-family: var(--font-sans);
    font-size: var(--font-size-h3);
    font-weight: 600;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: var(--space-8) 0 var(--space-4);
  }
  .case-narrative :global(p) {
    color: var(--color-body);
    max-width: none;
    margin-bottom: var(--space-5);
  }
  .case-narrative :global(em) {
    font-style: italic;
    color: var(--color-accent);
  }
</style>
