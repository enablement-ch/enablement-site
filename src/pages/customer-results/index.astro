---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudyCard from "../../components/CaseStudyCard.astro";
import MarqueeLogoWall from "../../components/MarqueeLogoWall.astro";
import { getCollection } from "astro:content";

const studies = (await getCollection("caseStudies"))
  .filter((cs) => cs.data.live)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const testimonials = [
  {
    quote: "I especially appreciated the personal support over Slack. Whenever I had a question for Lanny, Gilbert or Pablo, I could reach out by Loom or message. The answers came very quickly, and the team often went beyond the question to help. We now build all our campaigns internally because we have the knowledge to do it.",
    name: "Jascha Goerres",
    role: "Founder",
    company: "WE:Marq",
    initials: "JG",
  },
  {
    quote: "The meetings we booked were with our core ICP. They were high-quality meetings, and I had good discussions with those people. The quality was significantly better.",
    name: "Jan-Niklas Frantz",
    role: "Head of Buyer Enablement",
    company: "Emlen",
    initials: "JF",
  },
  {
    quote: "We hired Gilbert to support CXECO's sales growth plan and build a robust multichannel outbound channel. His extensive knowledge, commitment and willingness to go the extra mile have been invaluable to our team's sales outreach initiative.",
    name: "Benjamin Reimann",
    role: "Founder",
    company: "CXECO",
    initials: "BR",
    avatar: { src: "/reviews/benjamin-reimann-cxeco.png", x: 8, y: 28 },
  },
  {
    quote: "Every week someone calls us to offer sales support. With Gilbert it was different. I picked up the phone myself after his message made me curious. He doesn't just present the AI and automation tools, he shows how they work.",
    name: "Martin Benderoth",
    role: "Managing Director",
    company: "we-are-two",
    initials: "MB",
    avatar: { src: "/reviews/martin-benderoth-we-are-two.png", x: 20, y: 39 },
  },
  {
    quote: "Lanny helped us audit our sales process and implement a repeatable go-to-market strategy. We now have repeatable processes to find and contact high-quality prospects. He also has the interpersonal skills to move projects forward and get everyone on board.",
    name: "Daniel Matyas",
    role: "CEO",
    company: "Scale Systems",
    initials: "DM",
    avatar: { src: "/reviews/daniel-matyas-scale-systems.png", x: 22, y: 24 },
  },
  {
    quote: "We worked intensely with Gilbert on our outbound strategy for three months. His knowledge of strategy, content and the technical work impressed us. After three months, our outbound funnel was running and we had our first appointments with potential clients.",
    name: "Martin Bredl",
    role: "Managing Director",
    company: "takeoff",
    initials: "MB",
    avatar: { src: "/reviews/martin-bredl-takeoff.png", x: 8, y: 21 },
  },
  {
    quote: "The onboarding was very structured, and the team really took the time to understand our business. Communication was always direct, fast and helpful.",
    name: "Jan Dedersen",
    role: "Co-Founder",
    company: "Prosupo",
    initials: "JD",
    avatar: { src: "/reviews/jan-dedersen-prosupo.png", x: 21, y: 20 },
  },
  {
    quote: "Gilbert's structured, goal-oriented approach helped our lead pipeline enormously. We especially valued his ability to adapt to our needs and deliver tailored solutions. His professionalism and commitment made him a valuable partner.",
    name: "Markus Mayr",
    role: "Sales Manager",
    company: "fruitcore robotics",
    initials: "MM",
    avatar: { src: "/reviews/markus-mayr-fruitcore.png", x: 11, y: 19 },
  },
  {
    quote: "With Gilbert's support, we significantly increased both the quality and the number of our outbound leads. His analytical and systematic approach helped us build solid processes to scale outbound sales further.",
    name: "Ben Klein",
    role: "CEO",
    company: "BEE Digital Growth",
    initials: "BK",
    avatar: { src: "/reviews/ben-klein-bee-digital-growth.png", x: 15, y: 23 },
  },
  {
    quote: "Our expectations for both the quality and quantity of sales-qualified leads were met. The collaboration was marked by transparency, reliability and enjoyment in the work.",
    name: "Bülent Paradiso",
    role: "BDR",
    company: "BEE Digital Growth",
    initials: "BP",
    avatar: { src: "/reviews/buelent-paradiso-bee-digital-growth.png", x: 27, y: 17 },
  },
  {
    // Source: Scrypt case study deck in Drive, slide 12 (Daniel Matyas).
    quote: "We knew that our sales process was not efficient and depended too much on the founders. The Enablement Program showed us how to position ourselves clearly and build a sales system that would work without the founders. Within two weeks of the first campaign, we already had 11 highly qualified appointments booked in our calendar. Shortly after, we were able to onboard the first clients.",
    name: "Daniel Matyas",
    role: "Founding Partner",
    company: "Scrypt",
    initials: "DM",
    avatar: { src: "/reviews/daniel-matyas-scale-systems.png", x: 22, y: 24 },
  },
];
---

<BaseLayout
  title="B2B GTM Case Studies & Customer Results | Enablement.ch"
  description="Read B2B GTM case studies covering qualified meetings, outbound pipeline, LinkedIn content, and revenue systems built by Enablement."
>
  <header class="hero texture-glow">
    <div class="container">
      <div class="hero-inner">
        <span class="eyebrow">Clients</span>
        <h1 class="display">
          Systems we've <span class="italic-accent">shipped.</span>
        </h1>
        <p class="lead hero-lead">
          Each story features a real B2B company. See where they started,
          what we built, and what changed.
        </p>
      </div>
    </div>
  </header>

  <MarqueeLogoWall />

  <section class="section">
    <div class="container">
      <div class="case-grid">
        {studies.map((cs) => <CaseStudyCard cs={cs} />)}
      </div>
    </div>
  </section>

  <section class="section customer-voices" aria-labelledby="customer-voices-title">
    <div class="container">
      <div class="voices-heading">
        <span class="eyebrow">In their words</span>
        <h2 id="customer-voices-title">What clients say about the <span class="italic-accent">work.</span></h2>
      </div>

      <div class="testimonial-grid">
        {testimonials.map((review) => (
          <figure class="testimonial-card">
            <blockquote>{review.quote}</blockquote>
            <figcaption>
              <span class="avatar" aria-hidden="true">
                {review.avatar
                  ? <img src={review.avatar.src} alt="" loading="lazy" style={`left: -${review.avatar.x}px; top: -${review.avatar.y}px;`} />
                  : review.initials}
              </span>
              <span class="review-person"><strong>{review.name}</strong><span>{review.role} · {review.company}</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .customer-voices { background: var(--color-canvas); }
  .voices-heading { max-width: 720px; margin-bottom: 32px; }
  .voices-heading h2 { margin: 12px 0; }
  .testimonial-grid { columns: 3 300px; column-gap: 16px; }
  .testimonial-card { display: inline-flex; flex-direction: column; width: 100%; break-inside: avoid; margin: 0 0 16px; padding: 28px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 10px; }
  .testimonial-card blockquote { margin: 0 0 28px; color: var(--color-heading); font-size: clamp(1.05rem, 1.4vw, 1.25rem); line-height: 1.55; }
  .testimonial-card blockquote::before { content: "“"; color: var(--color-accent); }
  .testimonial-card blockquote::after { content: "”"; color: var(--color-accent); }
  .testimonial-card figcaption { display: flex; gap: 12px; align-items: center; margin-top: auto; }
  .avatar { position: relative; display: grid; place-items: center; overflow: hidden; flex: 0 0 42px; width: 42px; height: 42px; border: 1px solid var(--color-border-strong); border-radius: 50%; color: var(--color-heading); font: 500 .75rem var(--font-mono); }
  .avatar img { position: absolute; max-width: none; }
  .review-person { display: grid; gap: 2px; min-width: 0; }
  .review-person strong { color: var(--color-heading); font-size: .95rem; }
  .review-person span { color: var(--color-muted); font-size: .8rem; line-height: 1.45; }
  @media (max-width: 760px) { .testimonial-grid { columns: 2 270px; } .testimonial-card { padding: 24px; } }
  @media (max-width: 580px) { .testimonial-grid { columns: 1; } }
</style>
